---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import dailyArticles from '../data/daily-articles.json';
import blogArticles from '../data/blog-articles.json';
import weatherSummaryData from '../data/weather-summary.json';
import ctaCardsData from '../data/cta-cards.json';
import whaleAnalyses from '../data/whale-analyses.json';
import fs from 'fs';
import path from 'path';
import '../styles/home-redesign.css';
import MarketTicker from '../components/MarketTicker.jsx';

const latestBriefings = [...dailyArticles]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 5);

const latestWhales = [...whaleAnalyses]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

let marketData = { weatherData: { weather: 'sunny', emoji: '☀️', label: '맑음', headline: '오늘은 평화로운 날이에요', color: '#34d399', walletImpacts: [] }, raw: { oil: { price: 68.2, changePercent: -3.1 }, kospi: { price: 2684, changePercent: 0.4 }, krw: { price: 1475, changePercent: 0.6 }, sp500: { price: 4.32, changePercent: 0 } } };
try {
  const mdPath = path.resolve(process.cwd(), '.market-data.json');
  if (fs.existsSync(mdPath)) {
    marketData = JSON.parse(fs.readFileSync(mdPath, 'utf8'));
    if (!marketData.weatherData) marketData.weatherData = { weather: 'cloudy', emoji: '☁️', label: '흐림', headline: '위젯 데이터를 로딩중입니다...', color: '#94a3b8', walletImpacts: [] };
    if (!marketData.raw) marketData.raw = { oil: { price: 68.2, changePercent: -3.1 }, kospi: { price: 2684, changePercent: 0.4 }, krw: { price: 1475, changePercent: 0.6 }, sp500: { price: 4.32, changePercent: 0 } };
  }
} catch (e) {
  console.warn('Could not load .market-data.json', e.message);
}

const w = marketData.weatherData;
const r = marketData.raw;

function getCategoryCount(keywords) {
  return blogArticles.filter(a => a.tags?.some(t => keywords.includes(t))).length 
       + dailyArticles.filter(a => keywords.some(k => a.title.includes(k) || a.excerpt.includes(k))).length;
}

const cat1Count = getCategoryCount(['거시경제', '기초', 'GDP']) || 24;
const cat2Count = getCategoryCount(['투자', '자산', '주식', '코스피', '나스닥', 'ETF']) || 18;
const cat3Count = getCategoryCount(['부동산', '세금', '연금', '생활', '전세', '월세']) || 21;
const cat4Count = getCategoryCount(['환율', '글로벌', '미국', '금리']) || 15;

const categories = [
  { icon: 'book', title: '기초 경제학', desc: '"GDP가 오르면 내 월급도 오르나요?"', count: `${cat1Count}편 · 평균 4분`, href: '/economy/basics' },
  { icon: 'chart-line', title: '투자 기초', desc: '"ETF와 펀드, 뭐가 다른가요?"', count: `${cat2Count}편 · 평균 5분`, href: '/economy/investment' },
  { icon: 'wallet', title: '생활 금융', desc: '"전세 vs 월세, 지금은 뭐가 유리?"', count: `${cat3Count}편 · 평균 3분`, href: '/economy/finance' },
  { icon: 'globe', title: '글로벌 경제', desc: '"미국 금리가 한국 집값에 왜?"', count: `${cat4Count}편 · 평균 6분`, href: '/economy/global' },
];

const corpCount = getCategoryCount(['기업', '실적', '분석']) || 12;
const indicCount = getCategoryCount(['지표', 'PMI', '물가', '데이터']) || 16;
const trendCount = getCategoryCount(['트렌드', '이슈', '전망']) || 9;

function formatDateShort(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  const month = d.getMonth() + 1;
  const day = d.getDate();
  const weekdays = ['일', '월', '화', '수', '목', '금', '토'];
  const weekday = weekdays[d.getDay()];
  return { m: `${month}월`, d: `${day}`, w: weekday };
}

// KST(UTC+9) 기준 오늘 날짜 — GitHub Actions는 UTC 22:00 실행 → 빌드 시 UTC 날짜는 KST보다 하루 뒤처짐
const today = new Date(new Date().getTime() + 9 * 60 * 60 * 1000);
const weekdaysEn = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
const weatherIcons = ['weather-sunny', 'weather-cloudy', 'weather-rain', 'weather-storm'];
const weatherLabels = ['맑음', '흐림', '비', '폭풍'];

const emojiToIcon = {
  '☀️': 'weather-sunny',
  '⛅': 'weather-cloudy',
  '🌧️': 'weather-rain',
  '🌩️': 'weather-storm',
  '☁️': 'weather-cloudy'
};

let pastWeekData = [];
let nextWeekData = [];
try {
  const hPath = path.resolve(process.cwd(), 'src/data/weather-history.json');
  if (fs.existsSync(hPath)) pastWeekData = JSON.parse(fs.readFileSync(hPath, 'utf8'));
  const fPath = path.resolve(process.cwd(), 'src/data/weather-forecast.json');
  if (fs.existsSync(fPath)) nextWeekData = JSON.parse(fs.readFileSync(fPath, 'utf8'));
} catch (e) {
  console.warn('Could not load weather JSONs', e.message);
}

function generateWeekData(offsetDays, sourceData, forceCssClass) {
  return Array.from({length: 7}).map((_, i) => {
    const d = new Date(today);
    d.setDate(today.getDate() + offsetDays + i);
    const dateStr = d.toISOString().split('T')[0];
    
    let icon = 'weather-sunny';
    let label = '맑음';
    let event = '';
    
    const matched = sourceData.find(x => x.date === dateStr);
    if (matched) {
      icon = emojiToIcon[matched.emoji] || (matched.weather ? `weather-${matched.weather}` : 'weather-sunny');
      label = matched.label;
      event = matched.event || '';
    } else {
      const hash = d.getDate() * 37 % 4;
      icon = weatherIcons[hash];
      label = weatherLabels[hash];
    }
    
    return {
      dow: weekdaysEn[d.getDay()],
      dt: `${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`,
      icon,
      label,
      event,
      cssClass: forceCssClass
    };
  });
}

const pastWeek = generateWeekData(-7, pastWeekData, 'past');
const nextWeek = generateWeekData(1, nextWeekData, '');

const thisWeek = Array.from({length: 7}).map((_, i) => {
  const d = new Date(today);
  d.setDate(today.getDate() - 5 + i); // 5 days past, today, tomorrow
  const isToday = i === 5;
  const isTomorrow = i === 6;
  const isPast = i < 5;
  const dateStr = d.toISOString().split('T')[0];
  
  let icon = 'weather-sunny';
  let label = '맑음';
  let event = '';
  
  if (isToday) {
    icon = w.weather ? `weather-${w.weather}` : (emojiToIcon[w.emoji] || 'weather-sunny');
    label = w.label || '맑음';
  } else if (isTomorrow) {
    const matched = nextWeekData.find(x => x.date === dateStr);
    if (matched) {
      icon = emojiToIcon[matched.emoji] || (matched.weather ? `weather-${matched.weather}` : 'weather-sunny');
      label = `예보: ${matched.label}`;
      event = matched.event || '';
    } else {
      icon = 'weather-cloudy'; label = '예보: 흐림';
    }
  } else {
    const matched = pastWeekData.find(x => x.date === dateStr);
    if (matched) {
      icon = emojiToIcon[matched.emoji] || (matched.weather ? `weather-${matched.weather}` : 'weather-sunny');
      label = matched.label;
      event = matched.event || '';
    } else {
      const hash = d.getDate() * 37 % 4;
      icon = weatherIcons[hash];
      label = weatherLabels[hash];
    }
  }

  return {
    dow: isToday ? '오늘' : isTomorrow ? '내일' : weekdaysEn[d.getDay()],
    dt: `${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`,
    icon,
    label,
    event,
    cssClass: isToday ? 'today' : isPast ? 'past' : ''
  };
});

// ─── 트래픽 메트릭 로드 (빌드 타임) ─────────────────────
let siteStats = {
  total_visitors: 0,
  daily_visitors: 0,
  subscribers: 0,
  portfolio_users: 0
};
try {
  // 배포된 환경의 API에서 통계 데이터를 긁어옴 (SSG 빌드 시 최신값 반영)
  const statsRes = await fetch('https://econpedia.dedyn.io/api/stats');
  if (statsRes.ok) {
    const data = await statsRes.json();
    siteStats = { ...siteStats, ...data };
  }
} catch (err) {
  console.warn('⚠️ 빌드 중 사이트 통계 로드 실패:', err.message);
}

// ─── 1천만 원 표준 포트폴리오 시뮬레이션 (Real Market Data) ───
const baselinePortfolio = [
  { name: '국내 주식 (코스피)', weightStr: '50% · ₩5,000,000', amount: 5000000, change: r.kospi?.changePercent || 0, isUs: false },
  { name: '미국 주식 (S&P 500)', weightStr: '30% · ₩3,000,000', amount: 3000000, change: (r.sp500?.changePercent || 0) + (r.krw?.changePercent || 0), isUs: true },
  { name: '가상자산 (비트코인)', weightStr: '20% · ₩2,000,000', amount: 2000000, change: r.bitcoin?.changePercent || 0, isUs: false }
];

let totalRealImpact = 0;
const realHoldings = baselinePortfolio.map(item => {
  const impactValue = Math.round(item.amount * (item.change / 100));
  totalRealImpact += impactValue;
  
  const isUp = impactValue > 0;
  const isDn = impactValue < 0;
  
  let barWidthNum = Math.abs(item.change) * 10;
  if (barWidthNum > 100) barWidthNum = 100;
  if (barWidthNum < 5 && item.change !== 0) barWidthNum = 5;

  return {
    name: item.name,
    signalLabel: isUp ? '수익' : (isDn ? '손실' : '보합'),
    signalClass: isDn ? 'dn' : '',
    weight: item.weightStr,
    barWidth: `${barWidthNum}%`,
    barClass: isDn ? 'dn' : '',
    impactValue: `${impactValue > 0 ? '+' : (impactValue < 0 ? '−' : '')}₩${Math.abs(impactValue).toLocaleString()} · ${item.change > 0 ? '+' : ''}${item.change.toFixed(2)}%`,
    impactClass: isDn ? 'dn' : 'up',
    reason: item.isUs ? '환율 변동 포함 실제 타격감' : '시장 수익률 반영'
  };
});

const totalRealPercent = (totalRealImpact / 10000000) * 100;
const totalRealImpactStr = `${totalRealImpact > 0 ? '+' : (totalRealImpact < 0 ? '−' : '')}₩${Math.abs(totalRealImpact).toLocaleString()}`;
const totalRealPercentStr = `${totalRealPercent > 0 ? '+' : ''}${totalRealPercent.toFixed(2)}%`;

const isWeekend = today.getDay() === 0 || today.getDay() === 6;
const marketImpactLabel = isWeekend ? '전영업일(금) 종가 영향' : '오늘 시장 영향';
const realSummary = `지금 시장에 <b>1천만 원을 분산 투자</b>했다면 ${isWeekend ? '전영업일 종가 기준' : '오늘'} 내 지갑은 이렇게 변했습니다.`;

// 가장 변동성이 심한 4가지 지표 계산
const rawItems = [
  { id: 'kospi', title: '코스피', prefix: '', suffix: '', data: r.kospi },
  { id: 'nasdaq', title: '나스닥', prefix: '', suffix: '', data: r.nasdaq },
  { id: 'sp500', title: 'S&P 500', prefix: '', suffix: '', data: r.sp500 },
  { id: 'krw', title: '원/달러', prefix: '₩', suffix: '', data: r.krw },
  { id: 'oil', title: '원유(WTI)', prefix: '$', suffix: '', data: r.oil },
  { id: 'bitcoin', title: '비트코인', prefix: '$', suffix: '', data: r.bitcoin }
].filter(item => item.data);

const topImpacts = rawItems.sort((a, b) => Math.abs(b.data.changePercent || 0) - Math.abs(a.data.changePercent || 0)).slice(0, 4);

---

<BaseLayout
  title="🐋 Whale Alert — 검증가능한 내부자 거래 시그널"
  description="SEC·DART 공시 원문에 링크된 내부자·기관 거래 시그널. 거래 후 D+30/90/180/365 실제 주가 성적표와 인물별 트랙레코드까지. 추측이 아닌 검증가능한 데이터."
  hideSubHub={true}
>
  <div class="container" style="padding-top: 40px; padding-bottom: 80px;">

    <!-- ============================================================
      WHALE ALERT — 제품 히어로 (2026-05-31 pivot: Whale 단일 제품 front door)
    ============================================================ -->
    <section class="whale-home-hero" aria-label="Whale Alert">
      <div class="whale-home-hero__badge">🐋 WHALE ALERT · EconPedia</div>
      <h1 class="whale-home-hero__title">고래가 움직였다. <br />그래서 <em>그 후 올랐을까?</em></h1>
      <p class="whale-home-hero__sub">
        SEC Form 4 · DART 공시 <strong>원문에 링크된</strong> 내부자·기관 거래 시그널.
        거래 후 <strong>D+30/90/180/365 실제 주가 성적표</strong>와 인물별 트랙레코드까지 —
        뇌피셜이 아닌 <strong>검증가능한 데이터</strong>로.
      </p>
      <div class="whale-home-hero__cta">
        <a class="whale-home-hero__btn whale-home-hero__btn--primary" href="/whale">🐋 최신 고래 시그널 보기 →</a>
        <a class="whale-home-hero__btn whale-home-hero__btn--ghost" href="/wallet?utm_source=home&utm_medium=hero&utm_campaign=whale_signup">📲 내 종목 시그널 알림 받기</a>
      </div>
      <p class="whale-home-hero__alt">
        또는 1-tap 무료 구독:
        <a
          href="https://t.me/econpedia_channel"
          target="_blank"
          rel="noopener noreferrer"
          data-track-source="whale_tg_home"
          class="whale-home-hero__alt-link"
          aria-label="Telegram 채널에서 실시간 알림 받기 (새 탭에서 열림)"
        >📡 Telegram 채널 →</a>
        <a
          href="/whale/rss.xml"
          target="_blank"
          rel="alternate noopener"
          type="application/rss+xml"
          data-track-source="whale_rss_home"
          class="whale-home-hero__alt-link"
          aria-label="Whale Alert RSS 피드 (새 탭에서 열림)"
        >📰 RSS →</a>
      </p>
      <p class="whale-home-hero__disclaimer">투자 추천이 아닌 공개 공시 데이터 기반 정보 제공. 모든 수치는 원문에서 검증 가능.</p>
    </section>

    {latestWhales.length > 0 && (
      <section class="whale-home-latest" aria-label="최근 Whale 시그널">
        <div class="whale-home-latest__head">
          <h2 class="whale-home-latest__title">🐋 최근 감지된 시그널</h2>
          <a class="whale-home-latest__more" href="/whale?utm_source=home&utm_medium=latest&utm_campaign=whale_browse">전체 보기 →</a>
        </div>
        <div class="whale-home-latest__grid">
          {latestWhales.map((w) => (
            <a
              class={`whale-home-card ${w.isBuy ? 'whale-home-card--buy' : 'whale-home-card--sell'}`}
              href={`/whale/${w.slug}?utm_source=home&utm_medium=latest_card&utm_campaign=whale_view`}
            >
              <div class="whale-home-card__top">
                <span class="whale-home-card__market">{w.market === 'us' ? '🇺🇸 US' : '🇰🇷 KR'}</span>
                <span class={`whale-home-card__dir ${w.isBuy ? 'buy' : 'sell'}`}>{w.isBuy ? 'BUY' : 'SELL'}</span>
                <span class="whale-home-card__date">{w.date}</span>
              </div>
              <h3 class="whale-home-card__title">{w.title}</h3>
              {w.amount && <p class="whale-home-card__amount">{w.amount.split('·')[0].trim()}</p>}
              <p class="whale-home-card__excerpt">{w.excerpt}</p>
              <div class="whale-home-card__foot">
                <span>{w.companyName} ({w.ticker})</span>
                <span class="whale-home-card__read">분석 보기 →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ============================================================
      ISSUE 07 — WEEKLY WEATHER
    ============================================================ -->
    <div class="i7-strip">
      <div class="i7-top">
        <div>
          <div class="lb" id="weather-title">이번 주 경제 날씨</div>
          <h4 id="weather-headline">이번 주 시장은 대체로 <b style="color:var(--color-accent-primary)">맑음</b>, 목요일 하루만 비 소식이에요.</h4>
        </div>
        <div class="actions">
          <div class="b on">이번 주</div>
          <div class="b">지난 주</div>
          <div class="b">다음 주 예보</div>
        </div>
      </div>
      <div id="week-this" class="i7-week">
        {thisWeek.map((d) => (
          <div class={`i7-day ${d.cssClass}`}>
            <div class="dow">{d.dow}</div>
            <div class="dt">{d.dt}</div>
            <div class="icon"><Icon name={d.icon} size={24} /></div>
            <div class="lbl">{d.label}</div>
            {d.event && <div style="font-size:0.6rem; color:var(--color-accent-danger); margin-top:2px; font-weight:700; line-height:1.2; letter-spacing:-0.05em; word-break:keep-all;">{d.event}</div>}
          </div>
        ))}
      </div>
      <div id="week-past" class="i7-week" style="display:none;">
        {pastWeek.map((d) => (
          <div class={`i7-day ${d.cssClass}`}>
            <div class="dow">{d.dow}</div>
            <div class="dt">{d.dt}</div>
            <div class="icon"><Icon name={d.icon} size={24} /></div>
            <div class="lbl">{d.label}</div>
            {d.event && <div style="font-size:0.6rem; color:var(--color-accent-danger); margin-top:2px; font-weight:700; line-height:1.2; letter-spacing:-0.05em; word-break:keep-all;">{d.event}</div>}
          </div>
        ))}
      </div>
      <div id="week-next" class="i7-week" style="display:none;">
        {nextWeek.map((d) => (
          <div class={`i7-day ${d.cssClass}`}>
            <div class="dow">{d.dow}</div>
            <div class="dt">{d.dt}</div>
            <div class="icon"><Icon name={d.icon} size={24} /></div>
            <div class="lbl">{d.label}</div>
            {d.event && <div style="font-size:0.6rem; color:var(--color-accent-danger); margin-top:2px; font-weight:700; line-height:1.2; letter-spacing:-0.05em; word-break:keep-all;">{d.event}</div>}
          </div>
        ))}
      </div>
      <div class="i7-legend">
        <span><Icon name="weather-sunny" size={16} /> <b>맑음</b> · 주요 이벤트 없음</span>
        <span><Icon name="weather-cloudy" size={16} /> <b>흐림</b> · 지표 발표</span>
        <span><Icon name="weather-rain" size={16} /> <b>비</b> · 변동성 큼</span>
        <span><Icon name="weather-storm" size={16} /> <b>폭풍</b> · 위기 경보</span>
        <span style="margin-left:auto;color:var(--color-accent-primary);font-weight:700">매주 금요일, 다음 주 예보가 올라와요 →</span>
      </div>
    </div>

    <!-- ============================================================
      ISSUE 01 — HERO REBUILD
    ============================================================ -->
    <div class="h1-hero">
      <div class="pill"><span class="d"></span>LIVE · {formatDateShort(new Date(new Date().getTime() + 9*60*60*1000).toISOString().split('T')[0]).m} {formatDateShort(new Date(new Date().getTime() + 9*60*60*1000).toISOString().split('T')[0]).d}일 {formatDateShort(new Date(new Date().getTime() + 9*60*60*1000).toISOString().split('T')[0]).w} · 업데이트</div>
      <h3>{latestBriefings[0]?.title || w.headline || '기름값이 훅 떨어졌습니다. 주유소는 조금만 더 기다리세요.'}</h3>
      <div class="abs">{latestBriefings[0]?.excerpt || (w.walletSummary ? w.walletSummary.split('\n')[0] : '국제 유가가 3.1% 하락해 다음 주 국내 주유소 가격에 반영될 예정입니다.')} <b>{w.walletImpacts?.[0]?.label}</b></div>
      <div class="cta-row">
        <a href={latestBriefings[0] ? latestBriefings[0].href : '/daily'} class="cta-p" style="text-decoration:none">오늘 브리핑 3분 읽기 →</a>
        <a href="#newsletter-block" class="cta-s" style="text-decoration:none">매일 아침 받기</a>
