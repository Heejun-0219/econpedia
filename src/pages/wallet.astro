---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Load market data
let marketData = { weatherData: { weather: 'sunny', emoji: '☀️', label: '맑음', headline: '오늘은 평화로운 날이에요', color: '#34d399', walletImpacts: [] }, raw: {} };
try {
  const mdPath = path.resolve(__dirname, '../../.market-data.json');
  if (fs.existsSync(mdPath)) {
    marketData = JSON.parse(fs.readFileSync(mdPath, 'utf8'));
    if (!marketData.weatherData) marketData.weatherData = { weather: 'cloudy', emoji: '☁️', label: '흐림', headline: '위젯 데이터를 로딩중입니다...', color: '#94a3b8', walletImpacts: [] };
  }
} catch (e) {
  console.warn('Could not load .market-data.json', e.message);
}

const w = marketData.weatherData;

const impactIcons = {
  housing: 'home',
  travel: 'airplane',
  grocery: 'shopping-cart',
  gasoline: 'gas-pump',
  investment: 'chart-pie',
  crypto: 'currency-bitcoin',
  us_stock: 'flag-usa',
  calm: 'smile'
};

const getGuideLink = (category) => {
  const map = {
    housing: '/economy/finance',
    travel: '/economy/global',
    grocery: '/economy/finance',
    gasoline: '/economy/finance',
    investment: '/economy/investment',
    crypto: '/economy/investment',
    us_stock: '/economy/global'
  };
  return map[category] || '/economy/basics';
};

const today = new Date(new Date().getTime() + 9 * 60 * 60 * 1000);
const isWeekend = today.getDay() === 0 || today.getDay() === 6;
const reportDateLabel = isWeekend ? '전영업일(금) 종가 기준' : '오늘 기준';
const marketWeatherLabel = isWeekend ? '전영업일 시장' : '오늘의 시장';
---

<BaseLayout
  title="내 지갑 대시보드"
  description="오늘의 거시경제 변화가 내 생활비에 미치는 영향을 확인하세요."
>
  <div class="container" style="padding-top: 40px; padding-bottom: 80px;">

    <!-- Whale Alert 유입 시 컨텍스트 배너 (?ticker= 쿼리) — 클라이언트에서 검증 후 삽입 -->
    <div id="whale-ticker-banner-mount"></div>

    <!-- 로딩 스플래시 -->
    <div id="wallet-loading" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh; color: var(--color-text-muted);">
      <Icon name="clock" size={48} style="animation: spin 2s linear infinite; opacity: 0.5; margin-bottom: 16px;" />
      <p style="font-weight: 600;">안전하게 계정을 확인하고 있습니다...</p>
    </div>

    <!-- 비로그인 뷰 (Toss Style Splash) -->
    <div id="wallet-unauth-view" style="display: none; text-align: center; max-width: 500px; margin: 60px auto;">
      <div style="background: var(--color-bg-secondary); width: 80px; height: 80px; border-radius: 40px; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
        <Icon name="briefcase" size={40} style="color: var(--color-accent-primary);" />
      </div>
      <h1 id="wallet-unauth-title" style="font-size: 32px; font-weight: 800; margin-bottom: 16px; line-height: 1.3; color: var(--color-text-primary);">내 지갑,<br/>매일 얼마나 새고 있을까요?</h1>
      <p id="wallet-unauth-subtitle" style="font-size: 16px; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 40px;">
        복잡한 경제 뉴스 대신,<br/>내 대출 이자와 주식 타격감을 매일 아침 계산해 드립니다.
      </p>
      
      <button id="btn-google-login" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 12px; background: #ffffff; color: #111; border: 1px solid #e5e7eb; padding: 16px; border-radius: 16px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: var(--shadow-card); transition: all 0.2s;">
        <svg viewBox="0 0 24 24" width="24" height="24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Google로 3초 만에 시작하기
      </button>
      <button id="btn-demo-login" style="margin-top: 24px; background: transparent; border: none; color: var(--color-text-muted); font-size: 14px; text-decoration: underline; cursor: pointer;">로그인 없이 샘플 보기</button>
    </div>

    <!-- 로그인 뷰 (Dashboard) -->
    <div id="wallet-auth-view" style="display: none;">
      
      <!-- 상단 프로필 및 헤더 -->
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <img id="user-avatar" src="" style="width: 48px; height: 48px; border-radius: 24px; border: 1px solid var(--color-border); background: var(--color-bg-secondary); object-fit: cover;" />
          <div>
            <h1 style="font-size: 22px; font-weight: 800; margin: 0;"><span id="user-name">게스트</span>님의 지갑 타격감</h1>
            <p style="margin: 4px 0 0 0; font-size: 14px; color: var(--color-text-muted);">오늘 하루, 내 자산에 일어난 변화예요.</p>
          </div>
        </div>
        <button id="btn-logout" style="background: transparent; border: 1px solid var(--color-border); padding: 8px 16px; border-radius: 12px; font-size: 13px; font-weight: 600; color: var(--color-text-muted); cursor: pointer;">로그아웃</button>
      </div>

      <!-- Social Wallet Weather Card -->
      <div class="wallet-weather-share-card" id="share-card" style={`background: linear-gradient(145deg, var(--color-surface), var(--color-bg-secondary)); border: 1px solid var(--color-border); border-radius: 24px; padding: 32px; margin-bottom: 32px; position: relative; overflow: hidden; box-shadow: var(--shadow-card);`}>
        <!-- Background blur effect -->
        <div style={`position: absolute; top: -50%; right: -20%; width: 200px; height: 200px; background: ${w.color}; filter: blur(100px); opacity: 0.15; border-radius: 50%; pointer-events: none;`}></div>
        
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; position: relative; z-index: 1;">
          <div>
            <div style="font-size: 12px; font-weight: 700; color: var(--color-accent-primary); margin-bottom: 6px; letter-spacing: 0.5px;">Econ-Sync Data</div>
            <h2 style="font-size: 22px; font-weight: 800; margin: 0; color: var(--color-text-primary);">내 지갑 방어율 리포트</h2>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 12px; font-weight: 600; color: var(--color-text-muted);" id="report-date">{reportDateLabel}</div>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; position: relative; z-index: 1;">
          <!-- Market Weather -->
          <div style={`background: ${w.color}10; border: 1px solid ${w.color}20; border-radius: 16px; padding: 20px; text-align: center;`}>
            <div style={`color: ${w.color}; font-size: 13px; font-weight: 700; margin-bottom: 12px; opacity: 0.9;`}>{marketWeatherLabel}</div>
            <div style={`color: ${w.color}; margin-bottom: 12px; display: flex; justify-content: center;`}>
              <Icon name={`weather-${w.weather || 'cloudy'}`} size={48} />
            </div>
            <div style={`font-size: 18px; font-weight: 800; color: ${w.color}; margin-bottom: 4px;`}>{w.label || '흐림'}</div>
            <div style="font-size: 13px; color: var(--color-text-muted); font-weight: 600;">코스피 {marketData.raw?.kospi?.changePercent > 0 ? '+' : ''}{(marketData.raw?.kospi?.changePercent || 0).toFixed(2)}%</div>
          </div>

          <!-- Wallet Weather (Client updated) -->
          <div id="wallet-weather-box" style="background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 16px; padding: 20px; text-align: center; transition: all 0.3s ease;">
            <div style="color: var(--color-text-muted); font-size: 13px; font-weight: 700; margin-bottom: 12px; opacity: 0.9;">내 지갑</div>
            <div id="wallet-weather-icon-container" style="color: var(--color-text-muted); margin-bottom: 12px; display: flex; justify-content: center;">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/></svg>
            </div>
            <div id="wallet-weather-label" style="font-size: 18px; font-weight: 800; color: var(--color-text-muted); margin-bottom: 4px;">확인 중...</div>
            <div id="wallet-weather-desc" style="font-size: 13px; color: var(--color-text-muted); font-weight: 600;">데이터 연동 중</div>
          </div>
        </div>

        <div id="wallet-viral-msg" style="text-align: center; font-size: 15px; font-weight: 700; color: var(--color-text-primary); margin-bottom: 24px; position: relative; z-index: 1; word-break: keep-all; line-height: 1.4;">
          자산을 입력하고 <b>내 지갑의 진짜 타격감</b>을 확인하세요.
        </div>

        <button id="btn-share-story" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: #fff; padding: 16px; border-radius: 16px; font-size: 15px; font-weight: 700; border: none; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; position: relative; z-index: 1; box-shadow: 0 4px 12px rgba(220, 39, 67, 0.3);">
          <Icon name="smile" size={18} />
          Instagram 스토리에 공유하기
        </button>
        <div id="share-feedback" style="display: none; text-align: center; font-size: 13px; color: var(--color-accent-primary); font-weight: 700; margin-top: 12px;">공유 메뉴가 열렸습니다!</div>
      </div>

      <!-- Detail Grid -->
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; border-bottom: 1px solid var(--color-border); padding-bottom: 16px;">
        <h2 style="font-size: 20px; font-weight: 700; margin: 0; color: var(--color-text-primary);">종목별 타격감</h2>
        <button id="open-wallet-settings" style="display: flex; align-items: center; gap: 6px; padding: 8px 16px; background: var(--color-bg-secondary); color: var(--color-text-primary); border: 1px solid var(--color-border); border-radius: 12px; font-weight: 600; font-size: 13px; cursor: pointer; transition: background 0.2s;">
          <Icon name="settings" size={14} /> 내 자산 입력하기
        </button>
      </div>
      
      <div class="wallet-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 64px;">
        {(w.walletImpacts && w.walletImpacts.length > 0 ? w.walletImpacts : [
          { category: 'housing', emoji: '🏠', label: '주거비·대출이자', change: 0, sentiment: 'neutral', message: '대출 금리에 변화가 없어요 😌' },
          { category: 'grocery', emoji: '🛒', label: '장바구니·물가', change: 0, sentiment: 'neutral', message: '물가가 안정권이에요' },
          { category: 'gasoline', emoji: '⛽', label: '주유비·기름값', change: 0, sentiment: 'neutral', message: '기름값 변동이 거의 없어요' },
          { category: 'investment', emoji: '📊', label: '국내 주식·투자', change: 0, sentiment: 'neutral', message: '국내 시장이 조용해요' },
          { category: 'us_stock', emoji: '🇺🇸', label: '미국 주식·ETF', change: 0, sentiment: 'neutral', message: '미국 시장 변화가 작아요' },
          { category: 'crypto', emoji: '₿', label: '비트코인·코인', change: 0, sentiment: 'neutral', message: '가상자산 시장이 횡보 중이에요' },
          { category: 'travel', emoji: '✈️', label: '해외여행·직구', change: 0, sentiment: 'neutral', message: '환율이 안정적이에요' },
        ]).map((im) => (
            <div class="wallet-card" style="background: var(--color-bg-primary); border: 1px solid var(--color-border); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px; box-shadow: var(--shadow-card); transition: transform 0.2s;">
              <div class="wallet-card__header" style="display: flex; align-items: flex-start; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 12px; background: var(--color-bg-secondary); color: var(--color-text-primary);">
                    <Icon name={impactIcons[im.category] || 'document'} size={20} />
                  </span>
                  <span style="font-size: 16px; font-weight: 700; color: var(--color-text-primary);" set:html={im.label.replace('·', '<br/>')}></span>
                </div>
                <div class="wallet-card__badge" style={`padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 700; background: ${im.sentiment === 'positive' ? 'var(--color-accent-primary)' : im.sentiment === 'negative' ? 'var(--color-accent-danger)' : 'var(--color-bg-secondary)'}; color: ${im.sentiment === 'neutral' || im.sentiment === 'calm' ? 'var(--color-text-muted)' : '#fff'};`}>
                  {im.sentiment === 'positive' ? '긍정적' : im.sentiment === 'negative' ? '부정적' : '평안함'}
                </div>
              </div>
              
              <div class="wallet-card__body">
                <div class="wallet-card__value" style={`font-size: 22px; font-weight: 800; line-height: 1.3; color: ${im.sentiment === 'positive' ? 'var(--color-accent-primary)' : im.sentiment === 'negative' ? 'var(--color-accent-danger)' : 'var(--color-text-primary)'};`}>
                  {im.message.split(' (')[0]}
                </div>
                {im.message.includes('(') && (
                  <div class="wallet-card__note" style="margin-top: 6px; font-size: 13px; color: var(--color-text-muted);">
                    {im.message.substring(im.message.indexOf('('))}
                  </div>
                )}
              </div>

              <div class="wallet-card__action" style="margin-top: auto; padding-top: 16px; border-top: 1px solid var(--color-border);">
                <a href={getGuideLink(im.category)} style="text-decoration: none; width: 100%; display: flex; align-items: center; justify-content: space-between; color: var(--color-text-secondary); font-weight: 600; font-size: 14px;">
                  대응 가이드 보기 
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          ))}
      </div>

    </div>

    <!-- Personalization Modal (Toss Style Bottom Sheet) -->
    <div id="settings-modal" style="display: none; position: fixed; inset: 0; z-index: 9999; align-items: flex-end; justify-content: center; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
      <div class="bottom-sheet" style="background: var(--color-bg-primary); width: 100%; max-width: 600px; border-radius: 24px 24px 0 0; padding: 32px 24px 48px; box-shadow: 0 -8px 32px rgba(0,0,0,0.1); max-height: 85vh; overflow-y: auto;">
        <div style="width: 40px; height: 4px; background: var(--color-border-strong); border-radius: 2px; margin: 0 auto 24px;"></div>
        <h3 style="font-size: 22px; font-weight: 800; margin-bottom: 8px; color: var(--color-text-primary);">내 자산 입력하기</h3>
        <p style="color: var(--color-text-muted); font-size: 14px; margin-bottom: 24px;">입력된 정보는 오직 브라우저와 안전한 개인 계정에만 저장되며, 타격감 계산 용도로만 쓰입니다.</p>
        
        <form id="settings-form" style="display: flex; flex-direction: column; gap: 20px;">
          <div>
            <label class="wallet-label">주담대/전세대출 원금 (원)</label>
            <input type="text" inputmode="numeric" id="input-housing" placeholder="예: 300,000,000" class="wallet-input" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
              <label class="wallet-label">월 식료품비 (원)</label>
              <input type="text" inputmode="numeric" id="input-grocery" placeholder="예: 800,000" class="wallet-input" />
            </div>
            <div>
              <label class="wallet-label">1회 주유비 (원)</label>
              <input type="text" inputmode="numeric" id="input-gasoline" placeholder="예: 50,000" class="wallet-input" />
            </div>
          </div>
          <div>
            <label class="wallet-label">국내 주식 투자금 (원)</label>
            <input type="text" inputmode="numeric" id="input-investment" placeholder="예: 10,000,000" class="wallet-input" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
              <label class="wallet-label">미국 주식/ETF (원)</label>
              <input type="text" inputmode="numeric" id="input-us_stock" placeholder="예: 5,000,000" class="wallet-input" />
            </div>
            <div>
              <label class="wallet-label">비트코인 (원)</label>
              <input type="text" inputmode="numeric" id="input-crypto" placeholder="예: 1,000,000" class="wallet-input" />
            </div>
          </div>
          <div>
            <label class="wallet-label">해외여행/직구 예산 (원)</label>
            <input type="text" inputmode="numeric" id="input-travel" placeholder="예: 1,000,000" class="wallet-input" />
          </div>
          
          <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="button" id="close-wallet-settings" style="flex: 1; padding: 16px; background: var(--color-bg-secondary); border: none; border-radius: 16px; color: var(--color-text-primary); font-weight: 700; font-size: 15px; cursor: pointer;">닫기</button>
            <button type="submit" style="flex: 2; padding: 16px; background: var(--color-accent-primary); border: none; border-radius: 16px; color: white; font-weight: 700; font-size: 15px; cursor: pointer;">저장하고 확인하기</button>
          </div>
        </form>
      </div>
    </div>
    
    <script id="market-raw-data" type="application/json" set:html={JSON.stringify(marketData.raw || {})}></script>
    <script>
      import { supabase } from '../lib/supabase.js';

      document.addEventListener('DOMContentLoaded', async () => {
        const rawDataEl = document.getElementById('market-raw-data');
        if (!rawDataEl) return;
        const raw = JSON.parse(rawDataEl.textContent);
        
        const DEFAULTS = {
          housing: 300000000,
          grocery: 800000,
          gasoline: 50000,
          investment: 10000000,
          us_stock: 5000000,
          crypto: 1000000,
          travel: 1000000
        };

        let settings = { ...DEFAULTS };
        let currentUser = null;

        // Views
        const loadingView = document.getElementById('wallet-loading');
        const unauthView = document.getElementById('wallet-unauth-view');
        const authView = document.getElementById('wallet-auth-view');

        // Profile elements
        const userNameEl = document.getElementById('user-name');
        const userAvatarEl = document.getElementById('user-avatar');

        // Check Auth using getSession (handles initial load)
        try {
          const { data: { session }, error } = await supabase.auth.getSession();
          if (error) console.error("getSession error:", error);
          if (session) {
            currentUser = session.user;
            showAuthView(currentUser);
            await loadSettings(currentUser.id);
          } else {
            showUnauthView();
          }
        } catch(err) {
          console.error("Auth check failed", err);
          showUnauthView();
        }

        // Listen for auth state changes (crucial for OAuth redirects parsing)
        supabase.auth.onAuthStateChange(async (event, session) => {
          console.log("Supabase Auth Event:", event);
          if ((event === 'SIGNED_IN' || event === 'INITIAL_SESSION') && session) {
            if (!currentUser || currentUser.id !== session.user.id) {
              currentUser = session.user;
              showAuthView(currentUser);
              await loadSettings(currentUser.id);
            }
            if (event === 'SIGNED_IN') {
              const utmSrc = new URLSearchParams(window.location.search).get('utm_source');
              if (utmSrc && !sessionStorage.getItem('wfw_tracked')) {
                sessionStorage.setItem('wfw_tracked', '1');
                const src = `wallet_${utmSrc}`.replace(/[^a-z0-9_-]/gi, '_').slice(0, 20);
                fetch(`/api/track?source=${encodeURIComponent(src)}`).catch(() => {});
              }
            }
          } else if (event === 'SIGNED_OUT') {
            currentUser = null;
            showUnauthView();
          }
        });

        // Google Login Action
        document.getElementById('btn-google-login')?.addEventListener('click', async () => {
          const redirectUrl = window.location.origin + '/wallet' + window.location.search;
          console.log("Redirecting to:", redirectUrl);
          const { error } = await supabase.auth.signInWithOAuth({ 
            provider: 'google', 
            options: { redirectTo: redirectUrl } 
          });
          if (error) {
            console.error("OAuth Error:", error.message);
            alert("로그인 창을 띄우는 데 실패했습니다: " + error.message);
          }
        });

        // Demo Login Action (Skip Auth)
        document.getElementById('btn-demo-login')?.addEventListener('click', () => {
          currentUser = null; // Guest mode
          showAuthView(null);
          loadSettings(null); // Load local storage
        });

        // Logout
        document.getElementById('btn-logout')?.addEventListener('click', async () => {
          await supabase.auth.signOut();
          window.location.reload();
        });

        function showAuthView(user) {
          loadingView.style.display = 'none';
          unauthView.style.display = 'none';
          authView.style.display = 'block';

          if (user) {
            userNameEl.textContent = user.user_metadata?.full_name || '회원';
            userAvatarEl.src = user.user_metadata?.avatar_url || 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="%23ddd"><circle cx="24" cy="24" r="24"/></svg>';
            document.getElementById('btn-logout').style.display = 'block';
          } else {
            userNameEl.textContent = '게스트';
            userAvatarEl.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="%23ddd"><circle cx="24" cy="24" r="24"/></svg>';
            document.getElementById('btn-logout').style.display = 'none'; // 게스트 모드면 로그아웃 숨김
          }
        }

        function showUnauthView() {
          loadingView.style.display = 'none';
          unauthView.style.display = 'block';
          authView.style.display = 'none';
        }

        async function loadSettings(userId) {
          try {
            if (userId) {
              const { data, error } = await supabase
                .from('user_settings')
                .select('*')
                .eq('user_id', userId)
                .single();
              
              if (data && !error) {
                const dbSettings = { ...data };
                delete dbSettings.id;
                delete dbSettings.user_id;
                delete dbSettings.created_at;
                settings = { ...DEFAULTS, ...dbSettings };
              } else {
                const saved = localStorage.getItem('econpedia_wallet_settings');
                if (saved) {
                  settings = { ...DEFAULTS, ...JSON.parse(saved) };
                  const { error: upsertErr } = await supabase.from('user_settings').upsert({ user_id: userId, ...settings });
                  if (upsertErr) console.warn("Supabase upsert failed:", upsertErr.message);
                }
              }
            } else {
              const saved = localStorage.getItem('econpedia_wallet_settings');
              if (saved) settings = { ...DEFAULTS, ...JSON.parse(saved) };
            }
          } catch(err) {
            console.warn("loadSettings error (Supabase RLS/table missing?):", err.message);
            const saved = localStorage.getItem('econpedia_wallet_settings');
            if (saved) settings = { ...DEFAULTS, ...JSON.parse(saved) };
          }
          recalculate();
        }

        // Modals logic
        const modal = document.getElementById('settings-modal');
        const openBtn = document.getElementById('open-wallet-settings');
        const closeBtn = document.getElementById('close-wallet-settings');
        const form = document.getElementById('settings-form');

        // 천 단위 콤마 포맷터
        const formatNumberWithCommas = (num) => {
          if (num === '' || num === null || num === undefined) return '';
          const numeric = num.toString().replace(/[^0-9]/g, '');
          if (numeric === '') return '';
          return Number(numeric).toLocaleString();
        };

        const parseNumberFromCommas = (str) => {
          if (!str) return 0;
          return Number(str.replace(/,/g, ''));
        };

        // 입력 폼에 콤마 적용
        Object.keys(DEFAULTS).forEach(key => {
          const input = document.getElementById('input-' + key);
          if (input) {
            input.addEventListener('input', (e) => {
              const cursorPosition = e.target.selectionStart;
              const originalLength = e.target.value.length;
              const formatted = formatNumberWithCommas(e.target.value);
              e.target.value = formatted;
              const diff = formatted.length - originalLength;
              const newCursor = Math.max(0, cursorPosition + diff);
              e.target.setSelectionRange(newCursor, newCursor);
            });
          }
        });

        if(openBtn) {
          openBtn.addEventListener('click', () => {
            Object.keys(DEFAULTS).forEach(key => {
              const input = document.getElementById('input-' + key);
              if (input) input.value = formatNumberWithCommas(settings[key]);
            });
            // Bottom sheet animation effect
            modal.style.display = 'flex';
            const sheet = modal.querySelector('.bottom-sheet');
            sheet.animate([{transform: 'translateY(100%)'}, {transform: 'translateY(0)'}], {duration: 300, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)'});
          });
        }

        if(closeBtn) {
          closeBtn.addEventListener('click', () => {
            const sheet = modal.querySelector('.bottom-sheet');
            const anim = sheet.animate([{transform: 'translateY(0)'}, {transform: 'translateY(100%)'}], {duration: 250, easing: 'ease-in'});
            anim.onfinish = () => modal.style.display = 'none';
          });
        }

        if(form) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            Object.keys(DEFAULTS).forEach(key => {
              const input = document.getElementById('input-' + key);
              if (input) {
                const parsed = parseNumberFromCommas(input.value);
                settings[key] = parsed === 0 ? DEFAULTS[key] : parsed;
              }
            });

            if (currentUser) {
              try {
                await supabase.from('user_settings').upsert({ user_id: currentUser.id, ...settings });
              } catch (err) {
                console.error('DB 저장 실패:', err);
                localStorage.setItem('econpedia_wallet_settings', JSON.stringify(settings));
              }
            } else {
              localStorage.setItem('econpedia_wallet_settings', JSON.stringify(settings));
            }
            
            const sheet = modal.querySelector('.bottom-sheet');
            const anim = sheet.animate([{transform: 'translateY(0)'}, {transform: 'translateY(100%)'}], {duration: 250, easing: 'ease-in'});
            anim.onfinish = () => {
              modal.style.display = 'none';
              recalculate();
            };
          });
        }

        function formatChange(change, upText, downText) {
          if (change === 0) return '변동 없어요 😌';
          return change > 0 ? upText : downText;
        }

        // Recalculation logic
        function recalculate() {
          let netGain = 0;

          if (raw.baseRate) {
            const change = Math.round((settings.housing * (raw.baseRate.change / 100)) / 12);
            updateCard('housing', `내 대출금 기준 이번 달 이자가 약 ${Math.abs(change).toLocaleString()}원 ${formatChange(change, '늘었어요', '줄었어요')}`, change);
            netGain -= change;
          }
          if (raw.cpi) {
            const change = Math.round(settings.grocery * (raw.cpi.changePercent / 100));
            updateCard('grocery', `내 식비 체감 물가가 ${Math.abs(change).toLocaleString()}원 ${formatChange(change, '올랐어요', '내렸어요')}`, change);
            netGain -= change;
          }
          if (raw.oil) {
            // 0.5: 국제유가 → 국내 소비자가 실반영률 추산 (세금·유통마진 ~50-60% 차감)
            // 출처: 한국석유공사 Opinet 유가 구성 통계 https://www.opinet.co.kr
            const change = Math.round(settings.gasoline * (raw.oil.changePercent / 100) * 0.5);
            updateCard('gasoline', `1회 주유 시 약 ${Math.abs(change).toLocaleString()}원 ${formatChange(change, '올랐어요', '내렸어요')}`, change);
            netGain -= change;
          }
          if (raw.kospi) {
            const change = Math.round(settings.investment * (raw.kospi.changePercent / 100));
            updateCard('investment', `내 투자금 기준 약 ${Math.abs(change).toLocaleString()}원 ${formatChange(change, '올랐어요', '빠졌어요')}`, change);
            netGain += change;
          }
          if (raw.sp500 && raw.krw) {
            const change = Math.round(settings.us_stock * ((raw.sp500.changePercent + raw.krw.changePercent) / 100));
            updateCard('us_stock', `내 투자금 기준 약 ${Math.abs(change).toLocaleString()}원 ${formatChange(change, '올랐어요', '빠졌어요')}`, change);
            netGain += change;
          }
          if (raw.krw) {
            const change = Math.round(settings.travel * (raw.krw.changePercent / 100));
            updateCard('travel', `환전 시 ${Math.abs(change).toLocaleString()}원 더 ${formatChange(change, '비싸졌어요', '아꼈어요')}`, change);
            netGain -= change;
          }
          if (raw.bitcoin) {
            const change = Math.round(settings.crypto * (raw.bitcoin.changePercent / 100));
            updateCard('crypto', `내 투자금 기준 약 ${Math.abs(change).toLocaleString()}원 ${formatChange(change, '올랐어요', '빠졌어요')}`, change);
            netGain += change;
          }

          updateWalletWeatherCard(netGain);
        }

        function updateWalletWeatherCard(netGain) {
          const iconContainer = document.getElementById('wallet-weather-icon-container');
          const labelEl = document.getElementById('wallet-weather-label');
          const descEl = document.getElementById('wallet-weather-desc');
          const msgEl = document.getElementById('wallet-viral-msg');
          
          if (!iconContainer || !labelEl || !descEl || !msgEl) return;

          const totalAssets = settings.investment + settings.us_stock + settings.crypto;
          const totalDebtCost = settings.housing + settings.grocery + settings.gasoline + settings.travel;

          if (totalAssets === 0 && totalDebtCost === 0) {
            iconContainer.style.color = 'var(--color-text-secondary)';
            labelEl.style.color = 'var(--color-text-secondary)';
            document.getElementById('wallet-weather-box').style.background = 'rgba(148, 163, 184, 0.1)';
            document.getElementById('wallet-weather-box').style.borderColor = 'rgba(148, 163, 184, 0.2)';
            
            iconContainer.innerHTML = '<svg width="48" height="48" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/></svg>';
            labelEl.textContent = '데이터 없음';
            descEl.textContent = '내 자산을 입력해주세요';
            msgEl.innerHTML = '자산을 입력하고 <b>내 지갑의 진짜 타격감</b>을 확인하세요.';
            return;
          }

          // 스타일 초기화 (데이터가 있을 때)
          document.getElementById('wallet-weather-box').style.background = 'rgba(56, 189, 248, 0.1)';
          document.getElementById('wallet-weather-box').style.borderColor = 'rgba(56, 189, 248, 0.2)';

          let iconHtml = '';
          let labelText = '';
          let descText = '';
          let msgHtml = '';
          let color = '#38bdf8'; 

          // 우산 SVG (방어)
          const umbrellaSvg = '<g transform="translate(0, 2)"><path d="M23 12a11.05 11.05 0 0 0-22 0zm-5 7a3 3 0 0 1-6 0v-7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g>';
          // 해 SVG (상승장 맑음)
          const sunnySvg = '<circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2" fill="none"/><line x1="12" y1="2" x2="12" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="12" y1="20" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="2" y1="12" x2="4" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="20" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="4.93" y1="4.93" x2="6.34" y2="6.34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="17.66" y1="17.66" x2="19.07" y2="19.07" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="4.93" y1="19.07" x2="6.34" y2="17.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="17.66" y1="6.34" x2="19.07" y2="4.93" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>';
          // 구름 SVG
          const cloudySvg = '<path d="M17.5 19H9a7 7 0 116.71-4.9A5.5 5.5 0 0117.5 19z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>';
          // 번개 SVG
          const stormSvg = '<g transform="translate(0, 2)"><path d="M17.5 13H9a7 7 0 116.71-4.9A5.5 5.5 0 0117.5 13z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 14l-3.5 5h4.5l-4 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g>';

          if (netGain > 0) {
            color = '#10b981';
            const isMarketBad = document.querySelector('.wallet-weather-share-card').innerHTML.includes('weather-rain') || document.querySelector('.wallet-weather-share-card').innerHTML.includes('weather-storm');
            
            if (isMarketBad) {
              iconHtml = `<svg width="48" height="48" viewBox="0 0 24 24">${umbrellaSvg}</svg>`;
              labelText = '우산 (선방)';
              msgHtml = '시장은 폭우가 쏟아져도, <b>내 지갑은 안전</b>합니다.';
            } else {
              iconHtml = `<svg width="48" height="48" viewBox="0 0 24 24">${sunnySvg}</svg>`;
              labelText = '맑음 (수익)';
              msgHtml = '바람을 타고, <b>내 자산이 순항</b>하고 있습니다.';
            }
            descText = `+${formatNumberWithCommas(netGain)}원 상승/절약`;
          } else if (netGain > -10000) {
            color = '#f59e0b';
            iconHtml = `<svg width="48" height="48" viewBox="0 0 24 24">${cloudySvg}</svg>`;
            labelText = '흐림';
            descText = `${formatNumberWithCommas(netGain)}원 타격`;
            msgHtml = '약간의 손실, 아직 <b>시장 방어가 가능</b>한 수준입니다.';
          } else {
            color = '#ef4444';
            iconHtml = `<svg width="48" height="48" viewBox="0 0 24 24">${stormSvg}</svg>`;
            labelText = '폭풍';
            descText = `${formatNumberWithCommas(netGain)}원 타격`;
            msgHtml = '거센 폭풍우! 내 지갑에 <b>비상경보</b>가 켜졌습니다.';
          }

          iconContainer.style.color = color;
          labelEl.style.color = color;
          iconContainer.innerHTML = iconHtml;
          labelEl.textContent = labelText;
          descEl.textContent = descText;
          msgEl.innerHTML = msgHtml;
        }

        const shareBtn = document.getElementById('btn-share-story');
        if (shareBtn) {
          shareBtn.addEventListener('click', async () => {
            // 현재 상태 가져오기
            const currentGainStr = document.getElementById('wallet-weather-desc').textContent;
            let currentGain = 0;
            if (currentGainStr.includes('상승') || currentGainStr.includes('절약')) {
              currentGain = parseInt(currentGainStr.replace(/[^0-9]/g, ''), 10);
            } else if (currentGainStr.includes('타격')) {
              currentGain = -parseInt(currentGainStr.replace(/[^0-9]/g, ''), 10);
            }
            
            const marketLabel = document.querySelector('.wallet-weather-share-card').innerHTML.includes('weather-rain') || document.querySelector('.wallet-weather-share-card').innerHTML.includes('weather-storm') ? 'storm' : 'sunny';
            const isUmbrella = currentGain > 0 && marketLabel === 'storm';
            const weatherParam = isUmbrella ? 'umbrella' : (currentGain > 0 ? 'sunny' : 'cloudy');

            const shareUrl = `https://econpedia.dedyn.io/api/share/wallet?gain=${currentGain}&weather=${weatherParam}&market=${marketLabel}`;

            const shareData = {
              title: 'EconPedia 내 지갑 방어율 리포트',
              text: document.getElementById('wallet-viral-msg').innerText + '\\n\\n시장은 흔들려도, 내 지갑 날씨는 어떨까?\\n지갑을 연동하고 방어율을 확인하세요!',
              url: shareUrl,
            };
            try {
              if (navigator.share) {
                await navigator.share(shareData);
              } else {
                navigator.clipboard.writeText(shareData.url);
                const feedback = document.getElementById('share-feedback');
                feedback.style.display = 'block';
                setTimeout(() => feedback.style.display = 'none', 3000);
              }
            } catch (err) {
              console.log('공유 취소 또는 오류', err);
            }
          });
        }

        function updateCard(category, newMessage, changeValue) {
          const cards = document.querySelectorAll('.wallet-card');
          cards.forEach(card => {
            const badgeLabel = card.querySelector('.wallet-card__header span:nth-child(2)');
            if (!badgeLabel) return;
            const text = badgeLabel.textContent.trim();
            const map = {
              'housing': '주거비',
              'grocery': '장바구니',
              'gasoline': '주유비',
              'investment': '국내 주식',
              'us_stock': '미국 주식',
              'crypto': '비트코인',
              'travel': '해외여행',
            };
            
            if (text.includes(map[category])) {
              const valEl = card.querySelector('.wallet-card__value');
              const badgeEl = card.querySelector('.wallet-card__badge');
              
              if (valEl) {
                let color = 'var(--color-text-primary)';
                let sentimentText = '평안함';
                let bg = 'var(--color-bg-secondary)';
                
                if (category === 'housing' || category === 'grocery' || category === 'gasoline' || category === 'travel') {
                  if (changeValue > 0) { color = 'var(--color-accent-danger)'; sentimentText = '부정적'; bg = 'rgba(239,68,68,0.1)'; }
                  else if (changeValue < 0) { color = 'var(--color-accent-primary)'; sentimentText = '긍정적'; bg = 'rgba(16,185,129,0.1)'; }
                } else {
                  if (changeValue > 0) { color = 'var(--color-accent-primary)'; sentimentText = '긍정적'; bg = 'rgba(16,185,129,0.1)'; }
                  else if (changeValue < 0) { color = 'var(--color-accent-danger)'; sentimentText = '부정적'; bg = 'rgba(239,68,68,0.1)'; }
                }

                valEl.style.opacity = '0';
                setTimeout(() => {
                  valEl.textContent = newMessage;
                  valEl.style.color = color;
                  if (badgeEl) {
                    badgeEl.textContent = sentimentText;
                    badgeEl.style.color = color;
                    badgeEl.style.background = bg;
                  }
                  valEl.style.opacity = '1';
                }, 150);
              }
            }
          });
        };

      });
    </script>
  </div>
</BaseLayout>

<style>
  @keyframes spin { 100% { transform: rotate(360deg); } }
  .wallet-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-primary-alpha);
  }
  .wallet-label {
    display: block; font-size: 13px; font-weight: 700; color: var(--color-text-secondary); margin-bottom: 8px;
  }
  .wallet-input {
    width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--color-border); background: var(--color-bg-primary); color: var(--color-text-primary); font-size: 16px; font-weight: 600;
  }
  .wallet-input:focus {
    outline: none; border-color: var(--color-accent-primary); box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
  }
  /* Whale Alert 유입 컨텍스트 배너 */
  .whale-ticker-banner {
    background: linear-gradient(135deg, rgba(16,185,129,.15), rgba(56,189,248,.12));
    border: 1px solid rgba(16,185,129,.4); border-radius: 12px;
    padding: .85rem 1.25rem; margin-bottom: 1.5rem;
    text-align: center; font-size: .95rem; color: var(--color-text-primary);
  }
  .whale-ticker-banner strong { color: #10b981; margin-right: .35rem; }
  @media (max-width: 640px) {
    .whale-ticker-banner { font-size: .9rem; padding: .75rem 1rem; }
  }
</style>

<script is:inline>
  // Whale Alert 유입(?ticker=) 컨텍스트 배너 + 헤드라인 개인화 — strict whitelist + textContent로 XSS 방지
  (() => {
    const raw = new URLSearchParams(location.search).get('ticker');
    if (!raw) return;
    const ticker = raw.toUpperCase();
    if (!/^[A-Z0-9.\-]{1,10}$/.test(ticker)) return;
    const mount = document.getElementById('whale-ticker-banner-mount');
    if (!mount) return;
    const banner = document.createElement('div');
    banner.className = 'whale-ticker-banner';
    banner.setAttribute('role', 'status');
    const strong = document.createElement('strong');
    strong.textContent = `📲 ${ticker}`;
    banner.appendChild(strong);
    banner.appendChild(document.createTextNode(' 신호 알림을 받으려면 아래에서 지갑을 연동하세요.'));
    mount.appendChild(banner);
    // 비로그인 뷰 헤드라인·부제를 ticker 맞춤으로 교체
    const title = document.getElementById('wallet-unauth-title');
    const subtitle = document.getElementById('wallet-unauth-subtitle');
    if (title) {
      title.textContent = '';
      const line1 = document.createTextNode(ticker + ' 내부자 거래 알림 받기');
      const br = document.createElement('br');
      const line2 = document.createTextNode('30초, 무료.');
      title.appendChild(line1); title.appendChild(br); title.appendChild(line2);
    }
    if (subtitle) subtitle.textContent = '내부자가 매수·매도할 때 즉시 알림. 지갑 연동 후 관심 종목을 설정하세요.';
  })();
</script>