---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TradeCTA from '../../components/TradeCTA.astro';
import TickerLogo from '../../components/TickerLogo.astro';
import WhaleFollow from '../../components/WhaleFollow.astro';
import { isoWeekKey } from '../../../scripts/lib/iso-week.js';

let analyses = [];
try {
  const mod = await import('../../data/whale-analyses.json');
  analyses = mod.default || mod;
} catch { analyses = []; }

function formatDate(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  const month = d.getMonth() + 1;
  const day = d.getDate();
  const weekdays = ['일', '월', '화', '수', '목', '금', '토'];
  return `${month}월 ${day}일 (${weekdays[d.getDay()]})`;
}

// W3 주간 아카이브 (`/whale/week/<YYYY-Www>/`) 의 entry surface.
// W6 defensive (cycle 6, 2026-06-19): ISO week 키 정의는 scripts/lib/iso-week.js 단일 소스.
const weekCounts = new Map();
for (const a of analyses) {
  const key = isoWeekKey(a.date);
  if (!key) continue;
  weekCounts.set(key, (weekCounts.get(key) || 0) + 1);
}
const recentWeeks = Array.from(weekCounts.entries())
  .sort((a, b) => (a[0] < b[0] ? 1 : -1))
  .slice(0, 6);

const categories = [
  { id: 'all', title: '모두 보기' },
  { id: 'us', title: 'US' },
  { id: 'kr', title: 'KR' },
];
---

<BaseLayout
  title="Whale Alert"
  description="미국·한국 시장의 거대 자금 흐름을 매일 자동 스캔합니다. 내부자 거래, 기관 포지션 변동을 AI가 분석합니다."
>
  <section class="hero hero--whale" style="padding: 4rem 0 3rem; background: linear-gradient(to bottom, var(--color-surface) 0%, var(--color-background) 100%);">
    <div class="container text-center">
      <span class="hero__badge" style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2);">전체 시장 자동 스캔</span>
      <h1 class="hero__title" style="font-size: 2.8rem; margin: 1rem 0;">
        Whale Alert
      </h1>
      <p class="hero__subtitle" style="font-size: 1.1rem; max-width: 600px; margin: 0 auto; opacity: 0.8;">
        미국·한국 시장에서 오늘 가장 큰 돈이 움직인 곳.<br/>고정 목록 없이, AI가 매일 수백 건의 공시를 스캔합니다.
      </p>
      <p style="margin-top: 1rem; font-size: 0.85rem; opacity: 0.65;">
        <a href="/whale/rss.xml" rel="alternate" type="application/rss+xml" style="color: inherit; text-decoration: underline; text-decoration-style: dotted;">RSS 구독 (whale/rss.xml)</a>
      </p>
    </div>
  </section>

  <section class="whale-signup-banner">
    <div class="container">
      <div class="signup-banner__inner">
        <div class="signup-banner__text">
          <span class="signup-banner__badge">🔔 무료 알림</span>
          <p class="signup-banner__headline">내부자 거래 시그널, 내 지갑에 즉시 알림받기</p>
          <p class="signup-banner__sub">Whale이 움직이는 순간 Telegram으로 30초 안에 전달. 지갑 연동만 하면 됩니다.</p>
        </div>
        <a
          href="/wallet?utm_source=whale_index&utm_medium=banner&utm_campaign=wallet_signup"
          class="signup-banner__cta"
        >내 지갑 연동하기 →</a>
      </div>
    </div>
  </section>

  {recentWeeks.length > 0 && (
    <section class="whale-week-archive" aria-labelledby="whale-week-archive-heading">
      <div class="container">
        <h2 id="whale-week-archive-heading" class="whale-week-archive__heading">📅 주간 아카이브</h2>
        <p class="whale-week-archive__sub">한 주(월~일) 단위로 정리된 Whale 시그널. 검색 엔진과 북마크용 영구 URL.</p>
        <ul class="whale-week-archive__list">
          {/* W3 discovery funnel — entry click 측정 (WhaleFollow tracker 가 a[data-track-source] 자동 binding). hub 사용 (whale_weekly / whale_insider_idx) 과 비교해 hub UX vs discovery 문제 구분. */}
          {recentWeeks.map(([key, count]) => (
            <li>
              <a href={`/whale/week/${key}/`} class="whale-week-archive__pill" data-track-source="whale_week_entry">
                <span class="whale-week-archive__key">{key}</span>
                <span class="whale-week-archive__count">{count}건</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/whale/insider/" class="whale-week-archive__pill whale-week-archive__pill--insider" data-track-source="whale_insider_entry">
              <span class="whale-week-archive__key">👥 인물별</span>
              <span class="whale-week-archive__count">인덱스</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  )}

  <section class="whale-content" style="padding: 2rem 0 5rem;">
    <div class="container">
      <div class="whale-tabs">
        {categories.map((cat, idx) => (
          <button class={`whale-tab ${idx === 0 ? 'active' : ''}`} data-filter={cat.id}>
            {cat.title}
          </button>
        ))}
      </div>

      <div class="whale-grid" id="whale-grid">
        {analyses.length === 0 ? (
          <div class="whale-empty">
            <h3 style="margin: 0 0 0.5rem;">아직 감지된 Whale Signal이 없습니다</h3>
            <p style="opacity: 0.7; margin: 0;">매일 07:00 KST에 전체 시장을 자동 스캔합니다.</p>
          </div>
        ) : analyses.map((a) => {
          const isBuy = a.isBuy;
          const dirClass = isBuy ? 'whale-card--buy' : 'whale-card--sell';
          return (
            <a href={`/whale/${a.slug}`} class={`whale-card ${dirClass}`} data-market={a.market}>
              <div class="whale-card__header">
                <div class="whale-card__badge-row">
                  <span class="whale-card__market">{a.market === 'us' ? 'US' : 'KR'}</span>
                  <span class={`whale-card__direction ${isBuy ? 'buy' : 'sell'}`}>
                    {isBuy ? 'BUY' : 'SELL'}
                  </span>
                  <span class="whale-card__score" title="시그널 중요도">{a.significance}</span>
                </div>
                <span class="whale-card__date">{formatDate(a.date)}</span>
              </div>
              <h3 class="whale-card__title">{a.title}</h3>
              {a.amount && (
                <p class="whale-card__amount">{a.amount.split('·')[0].trim()}</p>
              )}
              <p class="whale-card__excerpt">{a.excerpt}</p>
              <div class="whale-card__footer">
                <span class="whale-card__ticker">{a.companyName} ({a.ticker})</span>
                <span class="whale-card__read">분석 보기 →</span>
              </div>
            </a>
          );
        })}
      </div>

      <div class="container" style="margin-top: 2rem; padding-bottom: 1rem;">
        <WhaleFollow ticker="WHALE" tickerName="모든 Whale 시그널" />
      </div>

      <div class="container">
        <div class="whale-compliance">
          <strong>⚠️ 투자 주의 · 면책</strong>
          <p>Whale Alert는 SEC·DART 등 <strong>공개 공시 데이터</strong>를 정리·시각화한 <strong>정보 제공 서비스</strong>입니다. 특정 종목의 매수·매도 <strong>추천이나 투자 자문이 아니며</strong>, '고래를 따라 거래'할 것을 권유하지 않습니다. 표시되는 D+30/90/180/365 수치는 <strong>과거 raw 종가 변동률(시장평균 미보정)</strong>로, <strong>과거 성과는 미래 수익을 보장하지 않습니다.</strong> 내부자 거래 동향은 다양한 사유(분산·세무·보상 등)로 발생하며 <strong>미공개중요정보(MNPI)의 이용을 시사하지 않습니다.</strong> 모든 수치는 각 페이지의 공시 원문 링크에서 직접 검증하시고, 투자 결정과 책임은 전적으로 본인에게 있습니다.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .whale-compliance {
    margin: 1.5rem 0 0;
    background: rgba(234, 179, 8, 0.07);
    border: 1px solid rgba(234, 179, 8, 0.28);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    font-size: 0.82rem;
  }
  .whale-compliance strong { color: #ca8a04; }
  .whale-compliance p { margin: 0.4rem 0 0; opacity: 0.82; line-height: 1.65; }

  .whale-week-archive {
    padding: 1.25rem 0 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .whale-week-archive__heading {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 700;
  }
  .whale-week-archive__sub {
    margin: 0 0 0.75rem;
    font-size: 0.82rem;
    opacity: 0.7;
  }
  .whale-week-archive__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .whale-week-archive__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.85rem;
    transition: background 0.15s;
  }
  .whale-week-archive__pill:hover { background: var(--color-background); }
  .whale-week-archive__pill--insider {
    border-color: rgba(168, 85, 247, 0.35);
    background: rgba(168, 85, 247, 0.06);
  }
  .whale-week-archive__pill--insider:hover {
    background: rgba(168, 85, 247, 0.1);
  }
  .whale-week-archive__key { font-weight: 600; }
  .whale-week-archive__count {
    opacity: 0.65;
    font-variant-numeric: tabular-nums;
  }
</style>

<style>
.whale-signup-banner {
  padding: 1.25rem 0;
  background: linear-gradient(135deg, rgba(16,185,129,.08) 0%, rgba(56,189,248,.08) 100%);
  border-bottom: 1px solid rgba(16,185,129,.2);
}
.signup-banner__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
}
.signup-banner__text { flex: 1; min-width: 200px; }
.signup-banner__badge {
  font-size: .75rem;
  font-weight: 700;
  padding: 2px 10px;
  border-radius: 99px;
  background: rgba(16,185,129,.15);
  color: #10b981;
  display: inline-block;
  margin-bottom: .5rem;
}
.signup-banner__headline {
  margin: 0 0 .25rem;
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-text);
}
.signup-banner__sub {
  margin: 0;
  font-size: .875rem;
  opacity: .75;
}
.signup-banner__cta {
  flex-shrink: 0;
  display: inline-block;
  padding: .75rem 1.5rem;
  border-radius: 10px;
  background: #10b981;
  color: #fff;
  font-weight: 700;
  font-size: .95rem;
  text-decoration: none;
  transition: transform .15s, box-shadow .15s;
  white-space: nowrap;
}
.signup-banner__cta:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(16,185,129,.35);
}
@media (max-width: 600px) {
  .signup-banner__inner { flex-direction: column; text-align: center; }
  .signup-banner__cta { width: 100%; text-align: center; }
}

.whale-tabs {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}
.whale-tab {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text);
  padding: 0.75rem 1.25rem;
  border-radius: 99px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}
.whale-tab:hover { border-color: #38bdf8; transform: translateY(-2px); }
.whale-tab.active { background: #38bdf8; color: #0f172a; border-color: #38bdf8; }

.whale-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 1.5rem;
}
.whale-empty {
  text-align: center; padding: 4rem; grid-column: 1/-1;
  background: var(--color-surface); border-radius: 12px; border: 1px dashed var(--color-border);
}

.whale-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 16px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  text-decoration: none;
  color: var(--color-text);
  position: relative;
  overflow: hidden;
}
.whale-card::before {
  content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; opacity: 0;
  transition: opacity 0.3s ease;
}
.whale-card--buy::before { background: linear-gradient(90deg, #10b981, #34d399); }
.whale-card--sell::before { background: linear-gradient(90deg, #ef4444, #f87171); }
.whale-card:hover { transform: translateY(-5px); box-shadow: 0 12px 24px rgba(0,0,0,0.15); }
.whale-card:hover::before { opacity: 1; }

.whale-card__header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;
}
.whale-card__badge-row { display: flex; align-items: center; gap: 8px; }
.whale-card__market { font-size: 1.2rem; }
.whale-card__direction {
  font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;
}
.whale-card__direction.buy { background: rgba(16,185,129,0.1); color: #10b981; }
.whale-card__direction.sell { background: rgba(239,68,68,0.1); color: #ef4444; }
.whale-card__score {
  font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px;
  background: rgba(56,189,248,0.1); color: #38bdf8;
}
.whale-card__date { font-size: 0.8rem; opacity: 0.6; }
.whale-card__title { font-size: 1.15rem; margin: 0 0 0.75rem; line-height: 1.4; }
.whale-card__amount {
  font-size: .85rem; font-weight: 700; color: var(--color-text-muted);
  margin: .2rem 0 .4rem; letter-spacing: .01em;
}
.whale-card__excerpt {
  font-size: 0.95rem; opacity: 0.75; margin: 0 0 1.5rem; line-height: 1.5;
  flex-grow: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.whale-card__footer {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 0.85rem; font-weight: 600; padding-top: 1rem; border-top: 1px dashed var(--color-border);
}
.whale-card__ticker { opacity: 0.8; }
.whale-card__read { color: #38bdf8; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const tabs = document.querySelectorAll('.whale-tab');
  const cards = document.querySelectorAll('.whale-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const filter = tab.getAttribute('data-filter');
      cards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-market') === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
});
</script>
