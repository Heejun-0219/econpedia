    <!-- Theme Toggle Script -->
    <script is:inline>
      (function() {
        const toggleBtn = document.getElementById('theme-toggle');
        if (!toggleBtn) return;

        const sunIcon = toggleBtn.querySelector('.sun-icon');
        const moonIcon = toggleBtn.querySelector('.moon-icon');

        function updateIcons(theme) {
          if (theme === 'dark') {
            sunIcon.style.display = 'none';
            moonIcon.style.display = 'block';
          } else {
            sunIcon.style.display = 'block';
            moonIcon.style.display = 'none';
          }
        }

        // 초기 아이콘 상태 설정
        updateIcons(document.documentElement.getAttribute('data-theme'));

        toggleBtn.addEventListener('click', () => {
          const currentTheme = document.documentElement.getAttribute('data-theme');
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('theme', newTheme);
          updateIcons(newTheme);
        });
      })();
    </script>

    <!-- 읽기 진행률 스크립트 -->
    <script is:inline>
      (function() {
        const progressBar = document.getElementById('reading-progress-bar');
        if (!progressBar) return;

        let lastKnownScrollPosition = 0;
        let ticking = false;

        function updateProgress(scrollPos) {
          const winHeight = window.innerHeight;
          const docHeight = document.body.offsetHeight;
          const totalScroll = docHeight - winHeight;
          const progress = (scrollPos / totalScroll) * 100;
          
          progressBar.style.width = Math.min(Math.max(progress, 0), 100) + '%';
          ticking = false;
        }

        window.addEventListener('scroll', function() {
          lastKnownScrollPosition = window.scrollY;

          if (!ticking) {
            window.requestAnimationFrame(function() {
              updateProgress(lastKnownScrollPosition);
            });
            ticking = true;
          }
        }, { passive: true });
      })();
    </script>

    <!-- Fuse.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7/dist/fuse.min.js"></script>
    <script>
      (function () {
        const modal = document.getElementById('search-modal');
        const backdrop = document.getElementById('search-backdrop');
        const input = document.getElementById('search-input');
        const results = document.getElementById('search-results');
        const hint = document.getElementById('search-hint');
        const closebtn = document.getElementById('search-close');
        const trigger = document.getElementById('search-trigger');

        let fuse = null;
        let selectedIdx = -1;
        let items = [];

        // Open modal
        function openModal() {
          modal.classList.add('search-modal--open');
          setTimeout(() => input.focus(), 50);
          if (!fuse) loadData();
        }

        // Close modal
        function closeModal() {
          modal.classList.remove('search-modal--open');
          input.value = '';
          results.innerHTML = '';
          results.appendChild(hint);
          selectedIdx = -1;
        }

        // Load search data
        async function loadData() {
          try {
            const res = await fetch('/search-data.json');
            const data = await res.json();
            fuse = new Fuse(data, {
              keys: [
                { name: 'title', weight: 0.7 },
                { name: 'excerpt', weight: 0.3 },
                { name: 'category', weight: 0.1 },
              ],
              threshold: 0.4,
              includeMatches: true,
            });
          } catch (e) {
            console.error('Search data load failed', e);
          }
        }

        // Render results
        function renderResults(query) {
          if (!fuse || !query.trim()) {
            results.innerHTML = '';
            results.appendChild(hint);
            items = [];
            selectedIdx = -1;
            return;
          }

          const found = fuse.search(query).slice(0, 8);
          items = found.map(r => r.item);

          if (items.length === 0) {
            results.innerHTML = `
              <div class="search-modal__empty">
                <svg class="search-modal__empty-icon icon-svg" viewBox="0 0 24 24" fill="none" width="48" height="48" style="margin-bottom: 1rem; opacity: 0.4;" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M16 16s-1.5-2-4-2-4 2-4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/><line x1="9" y1="9" x2="9.01" y2="9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="15" y1="9" x2="15.01" y2="9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <p>"${query}"에 대한 결과가 없습니다</p>
              </div>`;
            return;
          }

          results.innerHTML = items.map((item, i) => `
            <a href="${item.href}" class="search-result" role="option" data-idx="${i}" id="result-${i}">
              <div class="search-result__meta">
                <span class="search-result__icon">${item.icon}</span>
                <span class="search-result__category">${item.category}</span>
              </div>
              <div class="search-result__title">${item.title}</div>
              <div class="search-result__excerpt">${item.excerpt}</div>
            </a>
          `).join('');

          selectedIdx = -1;
        }

        // Keyboard navigation
        function updateSelection(newIdx) {
          const els = results.querySelectorAll('.search-result');
          els.forEach((el, i) => el.classList.toggle('search-result--active', i === newIdx));
          if (newIdx >= 0 && els[newIdx]) els[newIdx].scrollIntoView({ block: 'nearest' });
          selectedIdx = newIdx;
        }

        // Events
        trigger.addEventListener('click', openModal);
        backdrop.addEventListener('click', closeModal);
        closebtn.addEventListener('click', closeModal);

        input.addEventListener('input', (e) => renderResults(e.target.value));

        input.addEventListener('keydown', (e) => {
          const count = items.length;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            updateSelection(Math.min(selectedIdx + 1, count - 1));
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            updateSelection(Math.max(selectedIdx - 1, 0));
          } else if (e.key === 'Enter') {
            if (selectedIdx >= 0 && items[selectedIdx]) {
              window.location.href = items[selectedIdx].href;
            }
          } else if (e.key === 'Escape') {
            closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            modal.classList.contains('search-modal--open') ? closeModal() : openModal();
          }
          if (e.key === 'Escape' && modal.classList.contains('search-modal--open')) {
            closeModal();
          }
        });
      })();
    </script>

    <!-- 뉴스레터 구독 스크립트 -->
    <script>
      (function () {
        const form = document.getElementById('subscribe-form');
        if (!form) return;

        const emailInput = document.getElementById('subscribe-email');
        const btn = document.getElementById('subscribe-btn');
        const btnText = btn.querySelector('.subscribe-btn-text');
        const btnLoading = btn.querySelector('.subscribe-btn-loading');
        const feedback = document.getElementById('subscribe-feedback');

        function setLoading(on) {
          btn.disabled = on;
          btnText.style.display = on ? 'none' : '';
          btnLoading.style.display = on ? '' : 'none';
        }

        function showFeedback(message, isSuccess) {
          feedback.textContent = message;
          feedback.className = 'newsletter-feedback ' + (isSuccess ? 'newsletter-feedback--success' : 'newsletter-feedback--error');
          feedback.style.display = '';
        }

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = emailInput.value.trim();
          if (!email) return;

          setLoading(true);
          feedback.style.display = 'none';

          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });
            const data = await res.json();

            if (res.ok && data.success) {
              showFeedback(data.message || '구독 신청이 완료됐습니다.', true);
              emailInput.value = '';
              // 성공 시 버튼 텍스트 변경
              btnText.textContent = '구독 완료';
              btnText.style.display = '';
              btnLoading.style.display = 'none';
              btn.disabled = true;
              btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
            } else {
              showFeedback(data.error || '오류가 발생했습니다. 다시 시도해주세요.', false);
              setLoading(false);
            }
          } catch (err) {
            showFeedback('네트워크 오류가 발생했습니다. 잠시 후 다시 시도해주세요.', false);
            setLoading(false);
          }
        });
      })();
    </script>
    <!-- Pageview Tracking & Rendering Script -->
    <script>
      import { supabase } from '../lib/supabase.js';

      document.addEventListener('DOMContentLoaded', async () => {
        const isArticle = document.querySelector('meta[property="og:type"]')?.content === 'article' || document.querySelector('article') !== null;
        let slug = window.location.pathname.replace(/^\/|\/$/g, '');
        
        // 1. 기사 페이지인 경우 조회수 1 증가 (RPC 호출)
        if (isArticle && slug) {
          try {
            await supabase.rpc('increment_pageview', { article_slug: slug });
          } catch (e) {
            console.error('Pageview increment failed:', e);
          }
        }

        // 2. 화면에 .view-count-display 요소가 있으면 조회수 불러와서 렌더링
        const viewEls = document.querySelectorAll('.view-count-display');
        if (viewEls.length > 0) {
          const slugs = Array.from(viewEls).map(el => {
            const dataSlug = el.getAttribute('data-slug');
            return dataSlug ? dataSlug.replace(/^\/|\/$/g, '') : null;
          }).filter(Boolean);

          if (slugs.length > 0) {
            try {
              const { data, error } = await supabase
                .from('pageviews')
                .select('slug, view_count')
                .in('slug', slugs);

              if (data && !error) {
                const viewsMap = {};
                data.forEach(row => viewsMap[row.slug] = row.view_count);

                viewEls.forEach(el => {
                  const dataSlug = el.getAttribute('data-slug').replace(/^\/|\/$/g, '');
                  const count = viewsMap[dataSlug] || 0;
                  el.innerHTML = `<b>${count.toLocaleString()}명</b> 읽음`;
                });
              }
            } catch (e) {
              console.error('Pageview fetch failed:', e);
            }
          }
        }
      });
    </script>
