            <div id="auth-profile" style="display: none; align-items: center; gap: 10px;">
              <img id="auth-avatar" src="" alt="Profile" style="width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--color-border); background: var(--color-bg-secondary); object-fit: cover;" />
              <span id="auth-name" style="font-size: 13px; font-weight: 600; color: var(--color-text-primary); display: none;"></span>
              <button id="auth-logout-btn" style="padding: 4px 8px; background: transparent; border: 1px solid transparent; color: var(--color-text-muted); font-size: 12px; cursor: pointer;">로그아웃</button>
            </div>
