---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  article?: boolean;
  hideSubHub?: boolean;
  noindex?: boolean;
  /** ISO 8601 (YYYY-MM-DD). 미지정 시 whale URL 패턴에서 자동 추출. Article rich-result 자격용. */
  datePublished?: string;
}

const { title, description, ogImage = '/og-default.png', article = false, hideSubHub = false, noindex: noindexProp = false, datePublished: datePublishedProp } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// W1 pivot(2026-05-31): Whale 단일 제품 집중. legacy generic 콘텐츠(blog/daily/economy)는
// noindex로 동결(가역 — URL 유지, 검색 인덱스만 제외, 링크는 follow). 되돌리려면 prefix 제거.
const LEGACY_NOINDEX_PREFIXES = ['/blog', '/daily', '/economy'];
const _p = Astro.url.pathname;
const isNoindex = noindexProp || LEGACY_NOINDEX_PREFIXES.some((pre) => _p === pre || _p.startsWith(pre + '/'));

// W3 SEO wedge (cycle 6, 2026-06-18): Article rich-result 자격을 위해 datePublished/headline/image 명시.
// Google "Article rich result" + Open Graph article:* 메타로 검색·소셜 미리보기 강화.
// Whale 페이지 URL 패턴에서 자동 추출:
//   /whale/whale-<TICKER>-YYYY-MM-DD/   ← KR 6자리 또는 US ticker (현행 60+ 페이지)
//   /whale/whale-YYYYMMDD-<TICKER>/     ← legacy compact (pre-pivot orphan)
// 호출처에서 명시적 datePublished prop 을 주면 그것이 우선.
function deriveWhalePublishDate(pathname: string): string | null {
  if (!pathname) return null;
  const iso = pathname.match(/\/whale\/whale-[A-Za-z0-9가-힣]+-(\d{4}-\d{2}-\d{2})\/?$/);
  if (iso) return iso[1];
  const compact = pathname.match(/\/whale\/whale-(\d{4})(\d{2})(\d{2})-[A-Za-z0-9가-힣]+\/?$/);
  if (compact) return `${compact[1]}-${compact[2]}-${compact[3]}`;
  return null;
}
const publishedISO = datePublishedProp || deriveWhalePublishDate(_p);
const ogImageAbs = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).toString();

// W1 SEO wedge (cycle 8, 2026-06-26): Google "Breadcrumbs" rich result 자격을 위해
// /whale/* URL 패턴에서 BreadcrumbList 를 자동 생성. SERP 에 raw URL 대신
// "EconPedia > Whale Alert > <deal title>" 가 surface 되어 CTR 상승 기대.
// 호출처 props 변경 없이 retroactive 60+ whale 페이지 + week archive + insider hub 적용.
// 측정: 14일 후 Google Search Console "Breadcrumbs" rich result count + /whale/* CTR.
function deriveWhaleBreadcrumbs(pathname: string, pageTitle: string): Array<{ name: string; url: string }> | null {
  if (!pathname || !pathname.startsWith('/whale')) return null;
  const siteAbs = (Astro.site?.toString() || '').replace(/\/$/, '');
  const here = `${siteAbs}${pathname.endsWith('/') ? pathname : pathname + '/'}`;
  const base = [
    { name: 'EconPedia', url: `${siteAbs}/` },
    { name: 'Whale Alert', url: `${siteAbs}/whale/` },
  ];
  if (pathname === '/whale' || pathname === '/whale/') return base;
  if (pathname.startsWith('/whale/week/')) {
    const wk = pathname.replace(/^\/whale\/week\//, '').replace(/\/$/, '');
    if (wk) {
      // W1 SERP CTR (cycle 9 daily) — PR #216 BreadcrumbList 후속. Korean SERP 사용자에게
      // `2026-W23` raw key 대신 `2026년 23주차` readable label 노출. URL/canonical 불변,
      // BreadcrumbList JSON-LD `name` 만 변경 → 14일 후 GSC /whale/week/* CTR 동등 검증.
      const m = wk.match(/^(\d{4})-W(\d{2})$/);
      const label = m ? `${m[1]}년 ${Number(m[2])}주차` : wk;
      return [...base, { name: label, url: here }];
    }
  }
  if (pathname === '/whale/insider/' || pathname === '/whale/insider') {
    return [...base, { name: '인물별', url: `${siteAbs}/whale/insider/` }];
  }
  if (pathname.match(/^\/whale\/whale-/)) {
    return [...base, { name: pageTitle, url: here }];
  }
  return base;
}
const breadcrumbs = deriveWhaleBreadcrumbs(_p, title);

// W5 trust moat (cycle 9 SEC advisory): JSON-LD emit 시 `</script>` literal 차단.
// title 의 ultimate source 는 AI 생성(`scripts/generate-whale-analysis.js`) — prompt
// injection 시나리오에서 `</script>` 가 출력되면 set:html 이 script 태그를 조기 종료해
// 임의 HTML 주입 가능. `<` → `<` 치환은 JSON 디코더가 다시 `<` 로 복원하므로
// schema.org 파서 동작 보존, HTML 파서만 script 닫는 토큰을 인식 불가.
const jsonLD = (obj: unknown) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Theme Init (Prevent FOUC) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', systemDark ? 'dark' : 'light');
        }
      })();
    </script>

    <!-- SEO Meta -->
    <title>{title} | EconPedia</title>
    <meta name="description" content={description} />
    {isNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="EconPedia · Whale Alert" href="/whale/rss.xml" />
    
    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={`${title} | EconPedia`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:site_name" content="EconPedia — 경제 백과사전" />
    <meta property="og:locale" content="ko_KR" />
    {article && publishedISO && (
      <>
        <meta property="article:published_time" content={publishedISO} />
        <meta property="article:author" content="EconPedia" />
        {_p.startsWith('/whale/') && <meta property="article:section" content="Whale Alert" />}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | EconPedia`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={jsonLD(
      article
        ? {
            "@context": "https://schema.org",
            "@type": "Article",
            "headline": title,
            "description": description,
            "url": canonicalURL.toString(),
            "image": [ogImageAbs],
            "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL.toString() },
            ...(publishedISO ? { "datePublished": publishedISO, "dateModified": publishedISO } : {}),
            "author": { "@type": "Organization", "name": "EconPedia", "url": Astro.site?.toString() },
            "publisher": {
              "@type": "Organization",
              "name": "EconPedia",
              "logo": { "@type": "ImageObject", "url": `${Astro.site}favicon.svg` }
            }
          }
        : {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": `${title} | EconPedia`,
            "description": description,
            "url": canonicalURL.toString(),
            "potentialAction": {
              "@type": "SearchAction",
              "target": `${Astro.site}search?q={search_term_string}`,
              "query-input": "required name=search_term_string"
            }
          }
    )} />
    {breadcrumbs && breadcrumbs.length > 1 && (
      <script type="application/ld+json" set:html={jsonLD({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((b, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": b.name,
          "item": b.url,
        })),
      })} />
    )}

    <!-- Styles -->
    <style is:global>
      @import '../styles/global.css';
    </style>

    <!-- Visit Tracker -->
    <script is:inline>
      // 기존 단순 방문자 카운트 + utm_source 캡처 (Telegram·blogger 등 외부 유입 측정)
      if (!sessionStorage.getItem('visited')) {
        const utm = new URLSearchParams(location.search).get('utm_source');
        const trackUrl = utm ? `/api/track?source=${encodeURIComponent(utm)}` : '/api/track';
        fetch(trackUrl).catch(() => {});
        sessionStorage.setItem('visited', '1');
      }
    </script>

    <!-- Analytics Tracker (체류 시간 / 이탈률 자체 분석 로직) -->
    <script is:inline>
      (function() {
        try {
          const SESSION_KEY = 'ep_session_id';
          const PAGE_VIEW_KEY = 'ep_page_views';
          let sessionId = sessionStorage.getItem(SESSION_KEY);
          let isNewSession = false;
          
          if (!sessionId) {
            sessionId = 'sess_' + Math.random().toString(36).substr(2, 9);
            sessionStorage.setItem(SESSION_KEY, sessionId);
            sessionStorage.setItem(PAGE_VIEW_KEY, '1');
            isNewSession = true;
          } else {
            sessionStorage.setItem(PAGE_VIEW_KEY, parseInt(sessionStorage.getItem(PAGE_VIEW_KEY) || '1') + 1);
          }

          const pageViews = parseInt(sessionStorage.getItem(PAGE_VIEW_KEY));
          const isFirstPage = pageViews === 1;

          // 1. Pageview 기록
          fetch('/api/analytics', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'pageview', path: window.location.pathname, isNewSession })
          }).catch(() => {});

          let startTime = Date.now();
          let totalTimeSent = 0;

          // 2. 체류 시간 및 이탈률 전송 함수
          function sendAnalytics(isUnload = false) {
            const timeSpent = Math.floor((Date.now() - startTime) / 1000) - totalTimeSent;
            
            if (timeSpent > 0) {
              const dwellPayload = JSON.stringify({ type: 'dwell', timeSpent, path: window.location.pathname });
              
              if (isUnload && navigator.sendBeacon) {
                navigator.sendBeacon('/api/analytics', dwellPayload);
                
                // 10초 미만 체류 후 사이트를 떠나고, 조회한 페이지가 1개뿐이면 이탈(Bounce)로 간주
                if (isFirstPage && (timeSpent + totalTimeSent) < 10) {
                  navigator.sendBeacon('/api/analytics', JSON.stringify({ type: 'bounce', path: window.location.pathname }));
                }
              } else if (!isUnload) {
                fetch('/api/analytics', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: dwellPayload
                }).catch(() => {});
                totalTimeSent += timeSpent;
              }
            }
          }

          // 15초마다 주기적으로 체류 시간 동기화
          setInterval(() => {
            if (document.visibilityState === 'visible') {
              sendAnalytics();
            }
          }, 15000);

          // 탭 변경/종료 시 처리
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden') {
              sendAnalytics(true);
            } else {
              startTime = Date.now();
              totalTimeSent = 0;
            }
          });

          // ── G3: 스크롤 깊이(최대 도달 %) ──────────────────
          let maxScroll = 0;
          let scrollSent = false;
          function currentScrollPct() {
            const doc = document.documentElement;
            const scrollable = doc.scrollHeight - doc.clientHeight;
            if (scrollable <= 0) return 100;
            return Math.min(100, Math.round((doc.scrollTop / scrollable) * 100));
          }
          window.addEventListener('scroll', () => {
            const p = currentScrollPct();
            if (p > maxScroll) maxScroll = p;
          }, { passive: true });
          function sendScroll() {
            if (scrollSent) return;
            scrollSent = true;
            const payload = JSON.stringify({ type: 'scroll', depth: maxScroll, path: window.location.pathname });
            if (navigator.sendBeacon) navigator.sendBeacon('/api/analytics', payload);
            else fetch('/api/analytics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
          }
          window.addEventListener('pagehide', sendScroll);

          // ── G3: CTA 클릭 카운트(무PII — 라벨만) ───────────
          document.addEventListener('click', (e) => {
            const el = e.target && e.target.closest && e.target.closest('.wallet-cta-btn, [data-cta], a[href*="/wallet"]');
            if (!el) return;
            const label = el.getAttribute('data-cta') || (String(el.getAttribute('href') || '').includes('/wallet') ? 'wallet' : 'cta');
            const payload = JSON.stringify({ type: 'cta_click', label, path: window.location.pathname });
            if (navigator.sendBeacon) navigator.sendBeacon('/api/analytics', payload);
            else fetch('/api/analytics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
          }, { capture: true });

          // ── W3: 전역 nav UTM (data-nav-track-source, /api/track 화이트리스트) ──
          // WhaleFollow/home 의 a[data-track-source] 와 attribute 분리 → double-fire 없음.
          document.addEventListener('click', (e) => {
            const a = e.target && e.target.closest && e.target.closest('a[data-nav-track-source]');
            if (!a) return;
            const src = a.getAttribute('data-nav-track-source');
            if (!src) return;
            try {
              const blob = new Blob([''], { type: 'application/x-www-form-urlencoded' });
              navigator.sendBeacon && navigator.sendBeacon('/api/track?source=' + encodeURIComponent(src), blob)
                || fetch('/api/track?source=' + encodeURIComponent(src), { keepalive: true }).catch(() => {});
            } catch (_) { /* noop */ }
          }, { capture: true });
        } catch(e) {
          console.error('Analytics tracking error:', e);
        }
      })();
    </script>

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-59MT5S1PME"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-59MT5S1PME');
    </script>

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-8793696080407617">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8793696080407617" crossorigin="anonymous"></script>
  </head>
  <body>
    <!-- Reading Progress Bar -->
    <div class="reading-progress-container" aria-hidden="true">
      <div id="reading-progress-bar" class="reading-progress-bar"></div>
    </div>

    <!-- Navigation -->
    <nav class="nav" id="main-nav">
      <div class="nav__inner">
        <a href="/" class="nav__logo">
          <svg class="nav__logo-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="1"   y="16" width="5"  height="7"  rx="1.5" fill="currentColor" opacity="0.3"/>
            <rect x="9.5" y="10" width="5"  height="13" rx="1.5" fill="currentColor" opacity="0.65"/>
            <rect x="18"  y="4"  width="5"  height="19" rx="1.5" fill="currentColor"/>
            <path d="M3.5 16 Q12 3.5 20.5 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none"/>
          </svg>
          <span class="nav__logo-text">Econ<span class="nav__logo-text--sub">Pedia</span></span>
        </a>
        <ul class="nav__links">
          <li>
            <a href="/daily" class="nav__link nav__link--live">
              <span class="pulse-dot pulse-dot--sm" style="background-color: var(--color-accent-primary);"></span>
              데일리 브리핑
            </a>
          </li>
          <li>
            <a href="/wallet" class="nav__link nav__link--icon">
              <svg class="nav__link-icon" viewBox="0 0 24 24" fill="none" width="16" height="16" aria-hidden="true">
                <rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75" fill="none"/>
                <path d="M2 11h20" stroke="currentColor" stroke-width="1.5" opacity="0.35"/>
                <path d="M7 4l1.5-1h7L17 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.5"/>
                <rect x="14.5" y="13.5" width="5" height="4" rx="1" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="1.25"/>
                <circle cx="17" cy="15.5" r="1" fill="currentColor" opacity="0.7"/>
              </svg>
              내 지갑
            </a>
          </li>
          <li>
            <a href="/whale" class="nav__link nav__link--icon" data-nav-track-source="whale_nav_top">
              <svg class="nav__link-icon" viewBox="0 0 24 24" fill="none" width="16" height="16" aria-hidden="true">
                <rect x="2" y="7" width="20" height="15" rx="2" stroke="currentColor" stroke-width="1.75" fill="none"/>
                <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                <path d="M2 12h20" stroke="currentColor" stroke-width="1.5" opacity="0.35"/>
              </svg>
              포트폴리오
            </a>
          </li>
          <li><a href="/economy/basics" class="nav__link">기초 경제학</a></li>
          <li><a href="/economy/investment" class="nav__link">투자 기초</a></li>
          <li><a href="/economy/finance" class="nav__link">생활 금융</a></li>
          <li><a href="/economy/global" class="nav__link">글로벌 경제</a></li>
        </ul>
        <div class="nav__actions" style="display: flex; align-items: center; gap: 12px;">
          <button id="theme-toggle" class="nav__theme-btn" aria-label="테마 변경">
            <svg class="icon-svg sun-icon" viewBox="0 0 24 24"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 000-1.41l-1.06-1.06zm1.06-12.37a.996.996 0 00-1.41 0l-1.06 1.06a.996.996 0 101.41 1.41l1.06-1.06a.996.996 0 000-1.41zm-12.37 12.37l-1.06 1.06a.996.996 0 101.41 1.41l1.06-1.06a.996.996 0 000-1.41z"/></svg>
            <svg class="icon-svg moon-icon" viewBox="0 0 24 24" style="display: none;"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"/></svg>
