      .whale-layout-cta__text { font-size:.95rem; }
      .whale-layout-cta__actions { display:flex; gap:.5rem; flex-wrap:wrap; justify-content:flex-end; }
      .whale-layout-cta__btn { white-space:nowrap; padding:.6rem 1.25rem; background:#10b981; color:#fff; border-radius:8px; font-weight:700; font-size:.9rem; text-decoration:none; }
      .whale-layout-cta__btn:hover { background:#059669; }
      .whale-layout-cta__btn--tg { background:#229ED9; }
      .whale-layout-cta__btn--tg:hover { background:#1B8AC1; }
      @media (max-width:600px) { .whale-layout-cta { flex-direction:column; text-align:center; } .whale-layout-cta__actions { width:100%; flex-direction:column; } .whale-layout-cta__btn { width:100%; text-align:center; } }
    </style>
