---
// src/components/PollWidget.astro
// Phase 1: Micro-Reaction 기초 컴포넌트
export interface Props {
  questionId: string;
  question: string;
  optionA: string;
  optionB: string;
}

const { questionId, question, optionA, optionB } = Astro.props;
---

<div class="poll-widget" data-poll-id={questionId}>
  <div class="poll-header">
    <span class="poll-badge">EconPedia 커뮤니티 폴</span>
    <h3 class="poll-question">{question}</h3>
  </div>

  <div class="poll-options">
    <button class="poll-btn poll-btn--a" data-option="A">
      <span class="poll-btn-label">{optionA}</span>
      <div class="poll-btn-bg"></div>
      <span class="poll-btn-percent">0%</span>
    </button>
    <button class="poll-btn poll-btn--b" data-option="B">
      <span class="poll-btn-label">{optionB}</span>
      <div class="poll-btn-bg"></div>
      <span class="poll-btn-percent">0%</span>
    </button>
  </div>

  <div class="poll-footer">
    <p class="poll-login-prompt">
      <a href="#" class="poll-login-link">구글 로그인</a>하고 다른 투자자들의 생각을 확인하세요.
    </p>
    <p class="poll-result-info" style="display: none;">
      총 <span class="poll-total-votes">0</span>명 참여 중
    </p>
  </div>
</div>

<style>
  .poll-widget {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .poll-header {
    margin-bottom: 1.5rem;
  }

  .poll-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-primary);
    background: rgba(22, 163, 74, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    margin-bottom: 0.75rem;
  }

  .poll-question {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
  }

  .poll-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .poll-btn {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1rem 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .poll-btn:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  .poll-btn-label {
    position: relative;
    z-index: 1;
  }

  .poll-btn-percent {
    position: relative;
    z-index: 1;
    font-size: 0.9rem;
    opacity: 0.7;
    display: none; /* 투표 전에 숨김 */
  }

  .poll-btn-bg {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%; /* 기본 0, JS로 업데이트 */
    background: rgba(22, 163, 74, 0.15);
    transition: width 0.5s ease-out;
  }
  
  .poll-btn--b .poll-btn-bg {
    background: rgba(239, 68, 68, 0.15);
  }

  /* 투표 완료 상태 클래스 */
  .poll-widget.is-voted .poll-btn {
    cursor: default;
    transform: none;
  }
  
  .poll-widget.is-voted .poll-btn:hover {
    border-color: var(--color-border);
  }

  .poll-widget.is-voted .poll-btn-percent {
    display: block;
  }

  .poll-widget.is-voted .poll-btn.selected {
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 1px var(--color-accent-primary);
  }

  .poll-footer {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }

  .poll-login-link {
    color: var(--color-accent-primary);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }
</style>

<script>
  // Phase 1 MVP Client Logic (No DB connection yet, LocalStorage Mock)
  document.addEventListener('DOMContentLoaded', () => {
    const polls = document.querySelectorAll('.poll-widget');
    
    polls.forEach(poll => {
      const pollId = poll.getAttribute('data-poll-id');
      const btns = poll.querySelectorAll('.poll-btn');
      const loginPrompt = poll.querySelector('.poll-login-prompt');
      const resultInfo = poll.querySelector('.poll-result-info');
      const totalVotesSpan = poll.querySelector('.poll-total-votes');
      
      // Mock data
      let votesA = Math.floor(Math.random() * 50) + 10;
      let votesB = Math.floor(Math.random() * 50) + 10;

      // Check if already voted
      const votedOption = localStorage.getItem(`voted_${pollId}`);
      if (votedOption) {
        showResults(votedOption);
      }

      btns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          // TODO: 실제 구글 로그인 세션 체크로 변경 (현재는 클릭하면 바로 결과 보여주는 MVP)
          if (poll.classList.contains('is-voted')) return;
          
          const option = btn.getAttribute('data-option');
          if (option === 'A') votesA++;
          else votesB++;

          localStorage.setItem(`voted_${pollId}`, option);
          showResults(option);
        });
      });

      function showResults(selectedOption) {
        poll.classList.add('is-voted');
        loginPrompt.style.display = 'none';
        resultInfo.style.display = 'block';
        
        const total = votesA + votesB;
        totalVotesSpan.textContent = total;

        const percentA = Math.round((votesA / total) * 100);
        const percentB = 100 - percentA;

        const btnA = poll.querySelector('.poll-btn--a');
        const btnB = poll.querySelector('.poll-btn--b');

        btnA.querySelector('.poll-btn-percent').textContent = `${percentA}%`;
        btnA.querySelector('.poll-btn-bg').style.width = `${percentA}%`;
        
        btnB.querySelector('.poll-btn-percent').textContent = `${percentB}%`;
        btnB.querySelector('.poll-btn-bg').style.width = `${percentB}%`;

        if (selectedOption === 'A') btnA.classList.add('selected');
        if (selectedOption === 'B') btnB.classList.add('selected');
      }
    });
  });
</script>
