---
// src/components/PollWidget.astro
// Phase 1: Micro-Reaction 기초 컴포넌트 (Econ-Sync Data-Backed Faction Debate)
import Icon from './Icon.astro';

export interface Props {
  questionId: string;
  question: string;
  optionA: string;
  optionB: string;
}

const { questionId, question, optionA, optionB } = Astro.props;
---

<div class="poll-widget" data-poll-id={questionId}>
  <div class="poll-header">
    <span class="poll-badge">Econ-Sync 실시간 여론</span>
    <h3 class="poll-question">{question}</h3>
  </div>

  <!-- 투표 영역 -->
  <div class="poll-interaction-area">
    <div class="poll-options">
      <button class="poll-btn poll-btn--a" data-option="A">
        <span class="poll-btn-label">{optionA}</span>
        <div class="poll-btn-bg"></div>
        <span class="poll-btn-percent">0%</span>
      </button>
      <button class="poll-btn poll-btn--b" data-option="B">
        <span class="poll-btn-label">{optionB}</span>
        <div class="poll-btn-bg"></div>
        <span class="poll-btn-percent">0%</span>
      </button>
    </div>
  </div>

  <!-- 결과 탭 영역 (투표 후에만 보임) -->
  <div class="poll-results-area" style="display: none;">
    <div class="poll-tabs">
      <button class="poll-tab active" data-target="tab-all">전체 여론</button>
      <button class="poll-tab" data-target="tab-shareholder">
        주주 여론 <span class="poll-tab-lock"><Icon name="document" size={14} /></span>
      </button>
    </div>

    <!-- 전체 여론 탭 -->
    <div class="poll-tab-content active" id="tab-all">
      <div class="poll-options poll-options--result">
        <div class="poll-res poll-res--a">
          <div class="poll-res-top"><span class="lbl">{optionA}</span><span class="pct">0%</span></div>
          <div class="poll-res-bar-wrap"><div class="poll-res-bar"></div></div>
        </div>
        <div class="poll-res poll-res--b">
          <div class="poll-res-top"><span class="lbl">{optionB}</span><span class="pct">0%</span></div>
          <div class="poll-res-bar-wrap"><div class="poll-res-bar"></div></div>
        </div>
      </div>
      <p class="poll-result-info">총 <span class="poll-total-votes">0</span>명 참여 중</p>
    </div>

    <!-- 주주 여론 탭 (Wallet 미연동 블러 상태) -->
    <div class="poll-tab-content" id="tab-shareholder">
      <div class="poll-blur-overlay">
        <div class="poll-blur-content">
          <div class="poll-blur-icon"><Icon name="home" size={32} /></div>
          <h4>진짜 주주들은 어떻게 생각할까요?</h4>
          <p>내 포트폴리오를 연동하고, 이 자산을 실제로<br/>보유한 사람들의 진짜 여론을 확인하세요.</p>
          <a href="/wallet" class="poll-connect-btn">내 지갑 3초 만에 연동하기</a>
        </div>
        
        <!-- 블러된 가짜 데이터 배경 -->
        <div class="poll-options poll-options--result" style="filter: blur(8px); opacity: 0.4; pointer-events: none;">
          <div class="poll-res poll-res--a">
            <div class="poll-res-top"><span class="lbl">{optionA}</span><span class="pct">85%</span></div>
            <div class="poll-res-bar-wrap"><div class="poll-res-bar" style="width: 85%;"></div></div>
          </div>
          <div class="poll-res poll-res--b">
            <div class="poll-res-top"><span class="lbl">{optionB}</span><span class="pct">15%</span></div>
            <div class="poll-res-bar-wrap"><div class="poll-res-bar" style="width: 15%; background: rgba(239, 68, 68, 0.5);"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="poll-footer poll-login-prompt">
    <p>
      <a href="#" class="poll-login-link">구글 로그인</a>하고 내 의견을 남겨보세요.
    </p>
  </div>
</div>

<style>
  .poll-widget {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    margin: 2.5rem 0;
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .poll-header {
    margin-bottom: 1.5rem;
  }

  .poll-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-bg);
    background: var(--color-text);
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    margin-bottom: 0.75rem;
    letter-spacing: 0.5px;
  }

  .poll-question {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
    word-break: keep-all;
  }

  /* Interaction Area (Buttons) */
  .poll-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .poll-btn {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.1rem 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .poll-btn:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.1);
  }

  .poll-btn-label { position: relative; z-index: 1; }
  .poll-btn-percent { position: relative; z-index: 1; font-size: 0.95rem; display: none; font-weight: 700; }
  .poll-btn-bg {
    position: absolute; top: 0; left: 0; height: 100%; width: 0%;
    background: rgba(22, 163, 74, 0.1); transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .poll-btn--b .poll-btn-bg { background: rgba(239, 68, 68, 0.1); }

  /* Results Area (Tabs) */
  .poll-tabs {
    display: flex;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
  }

  .poll-tab {
    background: none;
    border: none;
    padding: 0.75rem 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .poll-tab.active {
    color: var(--color-text);
  }

  .poll-tab.active::after {
    content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px;
    background: var(--color-text); border-radius: 2px 2px 0 0;
  }

  .poll-tab-lock {
    display: flex; align-items: center; justify-content: center;
    color: var(--color-text-muted);
  }

  .poll-tab-content { display: none; }
  .poll-tab-content.active { display: block; animation: fadeIn 0.3s ease; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

  /* Result Bars */
  .poll-res { margin-bottom: 1rem; }
  .poll-res-top { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.95rem; font-weight: 600; }
  .poll-res-bar-wrap { height: 10px; background: var(--color-bg-elevated); border-radius: 99px; overflow: hidden; }
  .poll-res-bar { height: 100%; background: var(--color-accent-primary); width: 0%; transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1); }
  .poll-res--b .poll-res-bar { background: #ef4444; }

  .poll-result-info {
    font-size: 0.85rem; color: var(--color-text-muted); text-align: right; margin-top: 1rem;
  }

  /* Wallet Connect Blur Overlay */
  .poll-blur-overlay {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .poll-blur-content {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 10;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    text-align: center;
    padding: 1.5rem;
    background: rgba(var(--color-surface-rgb), 0.7);
    backdrop-filter: blur(2px);
  }

  .poll-blur-icon { color: var(--color-text); margin-bottom: 0.5rem; opacity: 0.8; }
  .poll-blur-content h4 { margin: 0 0 0.5rem; font-size: 1.1rem; color: var(--color-text); }
  .poll-blur-content p { margin: 0 0 1.25rem; font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.4; word-break: keep-all;}
  
  .poll-connect-btn {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.6rem 1.25rem;
    border-radius: 99px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  
  .poll-connect-btn:hover { transform: translateY(-2px); }

  /* Footer */
  .poll-footer {
    font-size: 0.85rem; color: var(--color-text-muted); text-align: center;
    margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--color-border);
  }
  .poll-login-link { color: var(--color-text); font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
</style>

<script>
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', () => {
    const polls = document.querySelectorAll('.poll-widget');
    
    polls.forEach(async (poll) => {
      const pollId = poll.getAttribute('data-poll-id');
      const interactionArea = poll.querySelector('.poll-interaction-area');
      const resultsArea = poll.querySelector('.poll-results-area');
      const btns = poll.querySelectorAll('.poll-btn');
      const loginPrompt = poll.querySelector('.poll-login-prompt');
      const totalVotesSpan = poll.querySelector('.poll-total-votes');
      
      const resA_pct = poll.querySelector('.poll-res--a .pct');
      const resA_bar = poll.querySelector('.poll-res--a .poll-res-bar');
      const resB_pct = poll.querySelector('.poll-res--b .pct');
      const resB_bar = poll.querySelector('.poll-res--b .poll-res-bar');

      const tabs = poll.querySelectorAll('.poll-tab');
      const tabContents = poll.querySelectorAll('.poll-tab-content');

      let votesA = 0;
      let votesB = 0;
      let votesA_Shareholder = 0;
      let votesB_Shareholder = 0;

      // Tab switching logic
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tabContents.forEach(c => c.classList.remove('active'));
          
          tab.classList.add('active');
          const targetId = tab.getAttribute('data-target');
          poll.querySelector(`#${targetId}`).classList.add('active');
          renderBars(); // 탭 바뀔 때 바 크기 재계산
        });
      });

      // Load data from Supabase
      async function loadPollData() {
        const { data: votes, error } = await supabase
          .from('poll_votes')
          .select('user_id, option_selected, is_shareholder')
          .eq('poll_id', pollId);

        if (error) {
          console.error("Poll data load error:", error);
          return;
        }

        votesA = 0; votesB = 0;
        votesA_Shareholder = 0; votesB_Shareholder = 0;
        let currentUserVoted = false;
        let myOption = null;

        const user = window.currentUser;

        votes.forEach(v => {
          if (v.option_selected === 'A') {
            votesA++;
            if (v.is_shareholder) votesA_Shareholder++;
          } else {
            votesB++;
            if (v.is_shareholder) votesB_Shareholder++;
          }
          if (user && v.user_id === user.id) {
            currentUserVoted = true;
            myOption = v.option_selected;
          }
        });

        if (currentUserVoted) {
          await showResults(myOption);
        }
      }

      await loadPollData();

      // Ensure poll exists in DB before voting (lazy creation)
      async function ensurePollExists() {
        const question = poll.querySelector('.poll-question').textContent;
        const optionA = poll.querySelector('.poll-btn--a .poll-btn-label').textContent;
        const optionB = poll.querySelector('.poll-btn--b .poll-btn-label').textContent;
        
        // upsert 대신 insert를 사용하여 기존 질문이 덮어씌워지는 취약점 방어
        const { error } = await supabase.from('polls').insert({
          poll_id: pollId,
          question: question,
          option_a: optionA,
          option_b: optionB
        });
        
        // 이미 생성된 방(23505 Unique Violation) 에러는 정상적인 흐름이므로 무시
        if (error && error.code !== '23505') {
          console.error("Poll creation error:", error);
        }
      }

      // Check real shareholder status from DB
      async function checkRealShareholderStatus(userId) {
        try {
          const { data, error } = await supabase
            .from('user_settings')
            .select('investment, us_stock, crypto')
            .eq('user_id', userId)
            .single();
            
          if (data && !error) {
            // 국내주식, 미국주식, 코인 중 하나라도 자산이 1원 이상 등록되어 있으면 주주로 인정
            if ((data.investment > 0) || (data.us_stock > 0) || (data.crypto > 0)) {
              return true;
            }
          }
        } catch (e) {
          console.warn("Failed to check shareholder status:", e);
        }
        return false;
      }

      btns.forEach(btn => {
        btn.addEventListener('click', async (e) => {
          if (poll.classList.contains('is-voted')) return;
          
          const user = window.currentUser;
          if (!user) {
            alert('구글 로그인이 필요합니다. 우측 상단의 버튼을 클릭하세요.');
            return;
          }
          
          const option = btn.getAttribute('data-option');
          btn.style.opacity = '0.5'; // 로딩 상태

          // 1. 방이 존재하는지 안전하게 확인 및 생성
          await ensurePollExists();

          // 2. 로컬 스토리지가 아닌 실제 DB 기반 주주(지갑) 연동 검증 (위변조 방어)
          const isShareholder = await checkRealShareholderStatus(user.id);

          // 3. 투표 기록
          const { error } = await supabase.from('poll_votes').insert({
            poll_id: pollId,
            user_id: user.id,
            option_selected: option,
            is_shareholder: isShareholder
          });

          if (error) {
            console.error("Vote insert error:", error);
            alert("투표 중 오류가 발생했습니다.");
            btn.style.opacity = '1';
            return;
          }

          await loadPollData();
        });
      });

      function renderBars() {
        const isShareholderTab = poll.querySelector('.poll-tab[data-target="tab-shareholder"]').classList.contains('active');
        
        let vA = isShareholderTab ? votesA_Shareholder : votesA;
        let vB = isShareholderTab ? votesB_Shareholder : votesB;
        
        const total = vA + vB;
        const percentA = total === 0 ? 0 : Math.round((vA / total) * 100);
        const percentB = total === 0 ? 0 : 100 - percentA;

        setTimeout(() => {
          if (resA_pct) resA_pct.textContent = `${percentA}%`;
          if (resA_bar) resA_bar.style.width = `${percentA}%`;
          if (resB_pct) resB_pct.textContent = `${percentB}%`;
          if (resB_bar) resB_bar.style.width = `${percentB}%`;
        }, 50);
      }

      async function showResults(selectedOption) {
        poll.classList.add('is-voted');
        
        interactionArea.style.display = 'none';
        resultsArea.style.display = 'block';
        loginPrompt.style.display = 'none';
        
        totalVotesSpan.textContent = votesA + votesB;

        // Check if user is shareholder (Real DB Check)
        let isShareholder = false;
        if (window.currentUser) {
          isShareholder = await checkRealShareholderStatus(window.currentUser.id);
        }

        if (isShareholder) {
          const blurOverlay = poll.querySelector('.poll-blur-overlay');
          const blurContent = poll.querySelector('.poll-blur-content');
          const resultOptions = blurOverlay.querySelector('.poll-options--result');
          
          if (blurContent) blurContent.style.display = 'none';
          if (resultOptions) {
            resultOptions.style.filter = 'none';
            resultOptions.style.opacity = '1';
            resultOptions.style.pointerEvents = 'auto';
          }
        }

        renderBars();
      }
    });
  });
</script>