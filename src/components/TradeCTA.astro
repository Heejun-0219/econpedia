---
export interface Props {
  ticker: string;
  name: string;
  price?: string;
  change?: string;
  isPositive?: boolean;
  isin?: string;
  // price/change are optional — omit to hide the price block (avoids stale hardcoded values)
}

const { ticker, name, price, change, isPositive = true, isin: isinProp } = Astro.props;

const isin = isinProp || ticker;
---

<div class="trade-cta-widget">
  <div class="trade-cta__header">
    <div class="trade-cta__info">
      <span class="trade-cta__name">{name}</span>
      <span class="trade-cta__ticker">{ticker}</span>
    </div>
    {price && (
      <div class="trade-cta__price-block">
        <span class="trade-cta__price">{price}</span>
        {change && <span class={isPositive ? 'trade-cta__change positive' : 'trade-cta__change negative'}>{change}</span>}
      </div>
    )}
  </div>
  
  <div class="trade-cta__actions">
    <button 
      class="trade-cta__btn trade-cta__btn--primary" 
      data-trade-buy-btn 
      data-ticker={ticker} 
      data-isin={isin}
    >
      토스증권에서 바로 구매하기
    </button>
    <button class="trade-cta__btn trade-cta__btn--secondary" data-trade-watchlist-btn data-name={name} data-ticker={ticker}>관심 종목에 담기</button>
  </div>
</div>

<div class="tw-cta">
  <div>
    <h3>📲 {name} 다음 신호 받기</h3>
    <p>내부자 거래 즉시 알림. 지갑 연동 30초, 무료.</p>
  </div>
  <a class="tw-cta-btn" href={`/wallet?utm_source=whale&utm_medium=tradecta&utm_campaign=wallet_signup&ticker=${encodeURIComponent(ticker)}`}>내 지갑에 추가 →</a>
</div>

<div class="whale-sticky-bar" id="whale-sticky-bar" role="complementary" aria-label="지갑 연동 알림">
  <p class="whale-sticky-bar__text">📡 <span>{ticker}</span> 다음 Whale 시그널 알림받기</p>
  <a
    class="whale-sticky-bar__cta"
    href={`/wallet?utm_source=whale&utm_medium=sticky_footer&utm_campaign=wallet_signup&ticker=${encodeURIComponent(ticker)}`}
  >내 지갑 연동 →</a>
  <button class="whale-sticky-bar__close" aria-label="닫기" id="whale-sticky-close">✕</button>
</div>

<script>
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. 매수 버튼 클릭 처리 (PC/Mobile 분기)
    const buyButtons = document.querySelectorAll('[data-trade-buy-btn]');
    buyButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const ticker = target.getAttribute('data-ticker') || '';
        const isin = target.getAttribute('data-isin') || '';
        
        // PC/Mobile 판단
        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        
        if (isMobile) {
          // 모바일: 앱 딥링크 (supertoss://stock/item?code=ISIN)
          const deepLink = `supertoss://stock/item?code=${isin}`;
          window.location.href = deepLink;
          
          // 앱 미설치 시 유니버설 링크로 폴백 (1.5초 후)
          setTimeout(() => {
            window.location.href = `https://toss.im/stock/item?code=${isin}`;
          }, 1500);
        } else {
          // PC: 웹 트레이딩 뷰 주문 화면 (https://www.tossinvest.com/stocks/[ISIN]/order)
          // ISIN이 없는 경우 티커 기반 기본 페이지로 이동
          const webUrl = (isin && (isin.startsWith('US') || isin.startsWith('KR')))
            ? `https://www.tossinvest.com/stocks/${isin}/order`
            : `https://www.tossinvest.com/stocks/${ticker}`;
          window.open(webUrl, '_blank');
        }
      });
    });

    // 2. 관심종목 버튼 클릭 처리
    const watchlistButtons = document.querySelectorAll('[data-trade-watchlist-btn]');
    watchlistButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const t = (e.currentTarget as HTMLElement).getAttribute('data-ticker') || '';
        const { data: { user } } = await supabase.auth.getUser();
        const medium = user ? 'tradecta' : 'watchlist_cta';
        window.location.href = `/wallet?ticker=${encodeURIComponent(t)}&utm_source=whale&utm_medium=${medium}&utm_campaign=wallet_signup`;
      });
    });

    // 3. Scroll-triggered sticky footer CTA
    const stickyBar = document.getElementById('whale-sticky-bar');
    const stickyClose = document.getElementById('whale-sticky-close');
    if (stickyBar && stickyClose) {
      const DISMISS_KEY = 'whale-sticky-dismissed';
      if (sessionStorage.getItem(DISMISS_KEY)) {
        stickyBar.remove();
      } else {
        const onScroll = () => {
          const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight);
          if (scrolled >= 0.4) {
            stickyBar.classList.add('visible');
            window.removeEventListener('scroll', onScroll);
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        stickyClose.addEventListener('click', () => {
          stickyBar.classList.remove('visible');
          sessionStorage.setItem(DISMISS_KEY, '1');
        });
      }
    }
  });
</script>

<style>
.trade-cta-widget {
  margin-top: 3rem;
  padding: 1.5rem;
  border-radius: 16px;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.trade-cta__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.trade-cta__info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.trade-cta__name {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--color-text-primary);
}

.trade-cta__ticker {
  font-size: 0.9rem;
  color: var(--color-text-muted);
}

.trade-cta__price-block {
  text-align: right;
}

.trade-cta__price {
  display: block;
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--color-text-primary);
}

.trade-cta__change {
  font-size: 0.9rem;
  font-weight: 600;
}

.trade-cta__change.positive { color: #f04452; } 
.trade-cta__change.negative { color: #3182f6; } 

.trade-cta__actions {
  display: flex;
  gap: 10px;
}

.trade-cta__btn {
  flex: 1;
  padding: 14px 16px;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.trade-cta__btn--primary {
  background: #3182f6; 
  color: white;
}

.trade-cta__btn--primary:hover {
  background: #1b64da;
}

.trade-cta__btn--secondary {
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border);
}

.trade-cta__btn--secondary:hover {
  background: var(--color-bg-card-hover);
}

@media (max-width: 600px) {
  .trade-cta__actions {
    flex-direction: column;
  }
}

.tw-cta {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  background: linear-gradient(135deg, rgba(16,185,129,.10), rgba(56,189,248,.10));
  border: 1px solid rgba(16,185,129,.35); border-radius: 14px;
  padding: 1.25rem 1.5rem; margin-top: 1rem;
}
.tw-cta > div { flex: 1; }
.tw-cta h3 { margin: 0 0 .25rem; font-size: 1rem; }
.tw-cta p { margin: 0; font-size: .875em; opacity: .85; }
.tw-cta-btn {
  display: inline-block; padding: .65rem 1.1rem; border-radius: 10px;
  background: #10b981; color: #fff; font-weight: 700; text-decoration: none; white-space: nowrap;
}
.tw-cta-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(16,185,129,.35); }
@media (max-width: 600px) { .tw-cta { flex-direction: column; align-items: stretch; text-align: center; } }

.whale-sticky-bar {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;
  background: var(--color-bg-card, #1a1a2e);
  border-top: 1px solid rgba(16,185,129,.4);
  padding: .75rem 1rem;
  display: flex; align-items: center; justify-content: space-between; gap: .75rem;
  transform: translateY(100%);
  transition: transform .3s ease;
  box-shadow: 0 -4px 20px rgba(0,0,0,.25);
}
.whale-sticky-bar.visible { transform: translateY(0); }
.whale-sticky-bar__text { flex: 1; font-size: .9rem; font-weight: 600; color: var(--color-text-primary, #fff); }
.whale-sticky-bar__text span { color: #10b981; }
.whale-sticky-bar__cta {
  padding: .55rem 1rem; border-radius: 10px;
  background: #10b981; color: #fff; font-weight: 700; font-size: .875rem;
  text-decoration: none; white-space: nowrap; flex-shrink: 0;
}
.whale-sticky-bar__cta:hover { background: #059669; }
.whale-sticky-bar__close {
  background: none; border: none; cursor: pointer; padding: .25rem;
  color: var(--color-text-muted, #888); font-size: 1.1rem; line-height: 1; flex-shrink: 0;
}
@media (max-width: 600px) {
  .whale-sticky-bar { flex-wrap: wrap; }
  .whale-sticky-bar__text { width: 100%; margin-bottom: .25rem; }
}
</style>
