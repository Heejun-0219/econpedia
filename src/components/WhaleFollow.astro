---
import analyses from '../data/whale-analyses.json';
// W6 — Astro 와 scripts/build-track-record.js 가 동일 정규화 결과를 내야 cross-trade 매칭이 일관.
// scripts/lib/whale-insider-key.js 가 단일 소스 (테스트 10건 통과).
import { normPersonKey, displayPersonName } from '../../scripts/lib/whale-insider-key.js';

export interface Props {
  ticker: string;
  tickerName?: string;
}
const { ticker, tickerName = ticker } = Astro.props;

// Related: 같은 ticker 우선, 미달 시 같은 category 로 보완. 자기 자신은 제외.
// currentSlug 는 Astro.url 에서 도출 (호출처 props 변경 없이 retroactive 60+ 페이지 적용).
const currentSlug = (Astro.url.pathname || '').replace(/^\/whale\//, '').replace(/\/$/, '');
const upTicker = String(ticker || '').toUpperCase();
const sameTicker = analyses
  .filter((a: any) => a.slug !== currentSlug && String(a.ticker || '').toUpperCase() === upTicker)
  .sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')));
const currentCategory = analyses.find((a: any) => a.slug === currentSlug)?.category;
const sameCategory = currentCategory
  ? analyses
      .filter((a: any) =>
        a.slug !== currentSlug &&
        a.category === currentCategory &&
        String(a.ticker || '').toUpperCase() !== upTicker
      )
      .sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')))
  : [];
const related = [...sameTicker, ...sameCategory].slice(0, 3);

// Related-by-insider: 동일 인물(역할 prefix 정규화)의 다른 거래.
// normPersonKey/displayPersonName 는 scripts/lib/whale-insider-key.js 에서 import.
// 같은 ticker 항목은 위 sameTicker 와 중복되므로 여기서는 *다른 ticker* 만 추린다.
const current = analyses.find((a: any) => a.slug === currentSlug);
const currentPersonKey = current ? normPersonKey(current.person) : '';
const currentPersonName = current ? displayPersonName(current.person) : '';
// 같은 인물(역할 prefix 정규화 기준) 의 다른 거래. ticker 동일 여부 무관 — 위 related 와 slug 중복만 제외.
// 대부분 insider 가 단일 ticker (track-record tier1Count=0) — 데이터 누적 후 cross-ticker 활성화.
const relatedSlugs = new Set(related.map((r: any) => r.slug));
const sameInsider = currentPersonKey
  ? analyses
      .filter((a: any) =>
        a.slug !== currentSlug &&
        !relatedSlugs.has(a.slug) &&
        normPersonKey(a.person) === currentPersonKey
      )
      .sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')))
      .slice(0, 3)
  : [];
---

<div class="whale-follow" id="whale-follow">
  <div class="whale-follow__icon">🔔</div>
  <div class="whale-follow__body">
    <h3 class="whale-follow__title">{tickerName} 다음 내부자 거래, 이메일로 받기</h3>
    <p class="whale-follow__desc">Whale 시그널 발생 즉시 분석 리포트를 보내드립니다. 무료, 언제든 취소 가능.</p>
    <form class="whale-follow__form" id="whale-follow-form">
      <input
        type="email"
        name="email"
        placeholder="이메일 주소"
        required
        autocomplete="email"
        class="whale-follow__input"
      />
      <button type="submit" class="whale-follow__btn">알림 받기</button>
    </form>
    <p class="whale-follow__alt">
      이메일 대신 다른 채널이 편하면:
      <a
        href="https://t.me/econpedia_channel"
        target="_blank"
        rel="noopener noreferrer"
        data-track-source="whale_tg"
        class="whale-follow__alt-link whale-follow__alt-link--tg"
        aria-label="Telegram 채널에서 실시간 알림 받기 (새 탭에서 열림)"
      >📡 Telegram 채널 →</a>
      <a
        href="/whale/rss.xml"
        target="_blank"
        rel="alternate noopener"
        type="application/rss+xml"
        data-track-source="whale_rss"
        class="whale-follow__alt-link whale-follow__alt-link--rss"
        aria-label="Whale Alert RSS 피드 구독 (새 탭에서 열림)"
      >📰 RSS 구독 →</a>
      <a
        href={`/wallet?utm_source=whale&utm_medium=follow_pill&utm_campaign=wallet_signup&ticker=${encodeURIComponent(ticker)}`}
        data-track-source="whale_wallet"
        class="whale-follow__alt-link whale-follow__alt-link--wallet"
        aria-label={`${tickerName} 포함 포트폴리오 전체를 지갑에 연동해 분석 받기`}
      >💼 지갑 연동 →</a>
    </p>
    <p class="whale-follow__success" id="whale-follow-success" style="display:none">
      ✅ 구독 완료! 다음 시그널 발생 시 바로 알려드릴게요.
      <a
        href={`/wallet?utm_source=whale&utm_medium=follow&utm_campaign=wallet_signup&ticker=${encodeURIComponent(ticker)}`}
        data-track-source="whale_postsub_wlt"
        class="whale-follow__wallet-link"
      >지갑 연동으로 포트폴리오 전체 분석 받기 →</a>
    </p>
  </div>
</div>

{related.length > 0 && (
  <aside class="whale-related" aria-labelledby="whale-related-title">
    <h4 id="whale-related-title" class="whale-related__title">
      🔁 같은 종목·섹터의 과거 Whale 시그널
    </h4>
    <ul class="whale-related__list">
      {related.map((r: any) => (
        <li class="whale-related__item">
          <a
            href={`/whale/${r.slug}/?utm_source=whale&utm_medium=related&utm_campaign=internal_link`}
            data-track-source="whale_related"
            class="whale-related__link"
          >
            <span class="whale-related__ticker">{r.ticker}</span>
            <span class="whale-related__person">{r.person}</span>
            <span class={`whale-related__dir whale-related__dir--${r.isBuy ? 'buy' : 'sell'}`}>
              {r.isBuy ? '매수' : '매도'}
            </span>
            <span class="whale-related__date">{r.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

{sameInsider.length > 0 && (
  <aside class="whale-related whale-related--insider" aria-labelledby="whale-insider-title">
    <h4 id="whale-insider-title" class="whale-related__title">
      👤 {currentPersonName}의 다른 거래
    </h4>
    <ul class="whale-related__list">
      {sameInsider.map((r: any) => (
        <li class="whale-related__item">
          <a
            href={`/whale/${r.slug}/?utm_source=whale&utm_medium=insider&utm_campaign=internal_link`}
            data-track-source="whale_insider"
            class="whale-related__link"
          >
            <span class="whale-related__ticker">{r.ticker}</span>
            <span class="whale-related__person">{r.companyName}</span>
            <span class={`whale-related__dir whale-related__dir--${r.isBuy ? 'buy' : 'sell'}`}>
              {r.isBuy ? '매수' : '매도'}
            </span>
            <span class="whale-related__date">{r.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<script>
document.addEventListener('DOMContentLoaded', () => {
  // 대체 채널(Telegram/RSS/Wallet) + Related 내부 링크 클릭 트래킹 — /api/track source 화이트리스트 (a-z0-9_-, ≤20).
  // 실패해도 outbound navigation 막지 않음.
  document.querySelectorAll<HTMLAnchorElement>('a[data-track-source]').forEach((a) => {
    a.addEventListener('click', () => {
      const src = a.dataset.trackSource;
      if (!src) return;
      try {
        const blob = new Blob([''], { type: 'application/x-www-form-urlencoded' });
        navigator.sendBeacon?.(`/api/track?source=${encodeURIComponent(src)}`, blob)
          || fetch(`/api/track?source=${encodeURIComponent(src)}`, { keepalive: true }).catch(() => {});
      } catch { /* noop */ }
    });
  });

  const form = document.getElementById('whale-follow-form') as HTMLFormElement | null;
  const success = document.getElementById('whale-follow-success');
  if (!form || !success) return;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = form.elements.namedItem('email') as HTMLInputElement;
    const email = emailInput?.value.trim();
    if (!email) return;

    const btn = form.querySelector('button') as HTMLButtonElement;
    const origText = btn.textContent;
    btn.disabled = true;
    btn.textContent = '처리 중…';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'whale' }),
      });
      if (res.ok) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || '구독 중 오류가 발생했습니다. 다시 시도해주세요.');
        btn.disabled = false;
        btn.textContent = origText;
      }
    } catch {
      alert('네트워크 오류가 발생했습니다. 다시 시도해주세요.');
      btn.disabled = false;
      btn.textContent = origText;
    }
  });
});
</script>

<style>
.whale-follow {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  background: linear-gradient(135deg, rgba(56,189,248,.08), rgba(16,185,129,.08));
  border: 1px solid rgba(56,189,248,.25);
  border-radius: 14px;
  padding: 1.25rem 1.5rem;
  margin: 2rem 0;
}
.whale-follow__icon {
  font-size: 1.75rem;
  flex-shrink: 0;
  line-height: 1;
  margin-top: 2px;
}
.whale-follow__body { flex: 1; min-width: 0; }
.whale-follow__title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-text-primary);
  margin: 0 0 .25rem;
}
.whale-follow__desc {
  font-size: .875rem;
  color: var(--color-text-muted);
  margin: 0 0 .75rem;
  line-height: 1.5;
}
.whale-follow__form {
  display: flex;
  gap: .5rem;
  flex-wrap: wrap;
}
.whale-follow__input {
  flex: 1;
  min-width: 180px;
  padding: .55rem .85rem;
  border-radius: 8px;
  border: 1px solid var(--color-border);
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
  font-size: .9rem;
}
.whale-follow__input:focus {
  outline: none;
  border-color: #38bdf8;
  box-shadow: 0 0 0 2px rgba(56,189,248,.2);
}
.whale-follow__btn {
  padding: .55rem 1.1rem;
  border-radius: 8px;
  background: #38bdf8;
  color: #fff;
  font-weight: 700;
  font-size: .9rem;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  transition: background .15s;
}
.whale-follow__btn:hover:not(:disabled) { background: #0ea5e9; }
.whale-follow__btn:disabled { opacity: .6; cursor: not-allowed; }
.whale-follow__alt {
  margin: .65rem 0 0;
  font-size: .8rem;
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: .5rem .75rem;
}
.whale-follow__alt-link {
  display: inline-flex;
  align-items: center;
  gap: .25rem;
  padding: .25rem .6rem;
  border-radius: 999px;
  font-size: .8rem;
  font-weight: 700;
  text-decoration: none;
  border: 1px solid transparent;
  transition: background .15s, border-color .15s;
}
.whale-follow__alt-link--tg {
  background: rgba(0, 136, 204, .12);
  color: #0088cc;
  border-color: rgba(0, 136, 204, .25);
}
.whale-follow__alt-link--tg:hover { background: rgba(0, 136, 204, .2); }
.whale-follow__alt-link--rss {
  background: rgba(234, 88, 12, .12);
  color: #ea580c;
  border-color: rgba(234, 88, 12, .25);
}
.whale-follow__alt-link--rss:hover { background: rgba(234, 88, 12, .2); }
.whale-follow__alt-link--wallet {
  background: rgba(16, 185, 129, .12);
  color: #10b981;
  border-color: rgba(16, 185, 129, .25);
}
.whale-follow__alt-link--wallet:hover { background: rgba(16, 185, 129, .2); }
.whale-follow__success {
  font-size: .9rem;
  color: #10b981;
  font-weight: 600;
  display: flex;
  flex-direction: column;
  gap: .4rem;
}
.whale-follow__wallet-link {
  font-size: .875rem;
  color: #38bdf8;
  text-decoration: none;
  font-weight: 600;
}
.whale-follow__wallet-link:hover { text-decoration: underline; }
@media (max-width: 600px) {
  .whale-follow { flex-direction: column; gap: .75rem; }
  .whale-follow__form { flex-direction: column; }
  .whale-follow__input { min-width: unset; }
  .whale-follow__btn { width: 100%; }
}

.whale-related {
  margin: 1rem 0 2rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background: var(--color-bg-primary);
}
.whale-related__title {
  font-size: .9rem;
  font-weight: 700;
  color: var(--color-text-primary);
  margin: 0 0 .65rem;
}
.whale-related__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: .35rem;
}
.whale-related__item { margin: 0; }
.whale-related__link {
  display: flex;
  align-items: center;
  gap: .5rem;
  padding: .5rem .6rem;
  border-radius: 8px;
  text-decoration: none;
  color: var(--color-text-primary);
  font-size: .85rem;
  transition: background .15s;
  flex-wrap: wrap;
}
.whale-related__link:hover { background: rgba(56, 189, 248, .08); }
.whale-related__ticker {
  font-weight: 700;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  color: #38bdf8;
}
.whale-related__person {
  flex: 1;
  min-width: 0;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.whale-related__dir {
  font-size: .72rem;
  font-weight: 700;
  padding: .1rem .45rem;
  border-radius: 4px;
}
.whale-related__dir--buy { background: rgba(16, 185, 129, .12); color: #10b981; }
.whale-related__dir--sell { background: rgba(239, 68, 68, .12); color: #ef4444; }
.whale-related__date {
  font-size: .72rem;
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}
@media (max-width: 600px) {
  .whale-related__link { font-size: .8rem; padding: .4rem .5rem; }
}
</style>
